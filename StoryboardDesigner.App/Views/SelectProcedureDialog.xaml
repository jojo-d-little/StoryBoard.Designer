<Window x:Class="StoryboardDesigner.App.Views.SelectProcedureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Procedure"
        Height="420"
        Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="#4B5563"
                   Text="Select a procedure definition to invoke. Procedures may be owned globally or by a specific object." />

        <DataGrid x:Name="ProceduresGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="ProceduresGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="2*" Binding="{Binding DisplayName}" />
                <DataGridTextColumn Header="Owner" Width="*" Binding="{Binding OwnerLabel}" />
                <DataGridTextColumn Header="Scope" Width="2*" Binding="{Binding ScopePath}" />
                <DataGridTextColumn Header="Id" Width="2*" Binding="{Binding ProcedureId}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="96" Margin="0,0,8,0" Content="Choose" Click="Choose_OnClick" />
            <Button Width="96" Margin="0,0,8,0" Content="Clear" Click="Clear_OnClick" />
            <Button Width="96" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
