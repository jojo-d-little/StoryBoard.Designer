<Window x:Class="StoryboardDesigner.App.Views.QuantifiableObjectPlacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Instance of Existing Object"
        Height="460"
        Width="620"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

         <TextBlock Margin="0,0,0,10"
             Foreground="#4B5563"
             TextWrapping="Wrap"
               Text="Pick an existing quantifiable base object and quantity for the new room instance. Scope path is shown in brackets and distribution mode is inherited from the selected base object." />

        <ListBox x:Name="ObjectsListBox"
                 Grid.Row="1"
                 DisplayMemberPath="Label"
                 MouseDoubleClick="ObjectsListBox_OnMouseDoubleClick" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Quantity" />
            <TextBox x:Name="QuantityTextBox"
                     Grid.Column="1"
                     VerticalContentAlignment="Center"
                     Text="1"
                     PreviewTextInput="QuantityTextBox_OnPreviewTextInput"
                     DataObject.Pasting="QuantityTextBox_OnPasting" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="140" Margin="0,0,8,0" Content="Add" Click="Add_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
