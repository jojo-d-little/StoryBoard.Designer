<Window x:Class="StoryboardDesigner.App.Views.SoundEffectEntryEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Effect Entry"
        Height="680"
        Width="760"
        MinHeight="680"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="SoundEffectId" />
            <TextBox x:Name="SoundEffectIdTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="SoundEffectKey" />
            <TextBox x:Name="SoundEffectKeyTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Display Name" />
            <TextBox x:Name="DisplayNameTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Lane" />
            <ComboBox x:Name="SoundEffectLaneComboBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" IsEditable="False" />

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Category" />
            <ComboBox x:Name="CategoryComboBox"
                      Grid.Row="4"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,10"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True" />

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Asset Ref" />
            <TextBox x:Name="AssetRefTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,10,10" TextChanged="AssetRefTextBox_OnTextChanged" />
            <Button Grid.Row="5" Grid.Column="2" Width="96" Content="Browse..." Click="BrowseAssetRef_OnClick" Margin="0,0,0,10" />

            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Source Duration" />
            <TextBlock x:Name="AssetDurationTextBlock" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" VerticalAlignment="Center" Foreground="#4B5563" Text="Unknown" />

            <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Preview" />
            <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="PreviewButton" Width="96" Margin="0,0,8,0" Content="Preview" Click="Preview_OnClick" />
                <Button x:Name="StopPreviewButton" Width="96" Margin="0,0,8,0" Content="Stop" Click="StopPreview_OnClick" IsEnabled="False" />
                <TextBlock x:Name="PreviewStatusTextBlock" VerticalAlignment="Center" Foreground="#4B5563" Text="Idle" />
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Pass Progress" />
            <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,8">
                <ProgressBar x:Name="PassProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="PassProgressTextBlock" Margin="0,4,0,0" Foreground="#4B5563" Text="0 / 0 ms" />
            </StackPanel>

            <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Overall Progress" />
            <StackPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,10">
                <ProgressBar x:Name="OverallProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="OverallProgressTextBlock" Margin="0,4,0,0" Foreground="#4B5563" Text="0 / 0 ms" />
            </StackPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Base Volume (dB)" />
            <TextBox x:Name="BaseVolumeDbTextBox" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Fade In (ms)" />
            <TextBox x:Name="FadeInMsTextBox" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Fade Out (ms)" />
            <TextBox x:Name="FadeOutMsTextBox" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="13" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Start Delay (ms)" />
            <TextBox x:Name="StartDelayMsTextBox" Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="14" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Max Play Duration (ms)" />
            <TextBox x:Name="MaxPlayDurationMsTextBox" Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

                <TextBlock Grid.Row="15" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Replay Policy" />
                <ComboBox x:Name="ReplayPolicyComboBox"
                      Grid.Row="15"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,10"
                      IsEditable="False" />

            <Border x:Name="RepeatSettingsBorder"
                    Grid.Row="16"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,10"
                    Padding="10"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="#F9FAFB">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Repeat Mode" />
                    <ComboBox x:Name="RepeatModeComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              IsEditable="False"
                              SelectionChanged="RepeatModeComboBox_OnSelectionChanged" />

                    <TextBlock x:Name="RepeatCountLabel" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Repeat Count" />
                    <TextBox x:Name="RepeatCountTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" />

                    <TextBlock x:Name="RepeatTimingTypeLabel" Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Repeat Timing" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="NoRepeatTimingRadioButton"
                                     GroupName="RepeatTiming"
                                     Content="No interval"
                                     Margin="0,0,20,0"
                                     ToolTip="Do not set an interval between repeats."
                                     Checked="RepeatTiming_OnChecked" />
                        <RadioButton x:Name="FixedRepeatTimingRadioButton"
                                     GroupName="RepeatTiming"
                                     Content="Fixed delay"
                                     Margin="0,0,20,0"
                                     ToolTip="Use the same delay after every repeat."
                                     Checked="RepeatTiming_OnChecked" />
                        <RadioButton x:Name="RandomRepeatTimingRadioButton"
                                     GroupName="RepeatTiming"
                                     Content="Randomized delay"
                                     ToolTip="Choose a new delay between the minimum and maximum for each repeat."
                                     Checked="RepeatTiming_OnChecked" />
                    </StackPanel>

                    <TextBlock x:Name="RepeatIntervalLabel" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Fixed Interval (ms)" />
                    <TextBox x:Name="RepeatIntervalMsTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" />

                    <TextBlock x:Name="RepeatIntervalMinLabel" Grid.Row="4" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Random Interval Min (ms)" />
                    <TextBox x:Name="RepeatIntervalMinMsTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" />

                    <TextBlock x:Name="RepeatIntervalMaxLabel" Grid.Row="5" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Random Interval Max (ms)" />
                    <TextBox x:Name="RepeatIntervalMaxMsTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" />

                    <TextBlock x:Name="RepeatDurationLabel" Grid.Row="6" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Repeat Duration (ms)" />
                    <TextBox x:Name="RepeatDurationMsTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" />

                    <TextBlock x:Name="RepeatCooldownLabel" Grid.Row="7" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="Repeat Cooldown (ms)" />
                    <TextBox x:Name="RepeatCooldownMsTextBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,0" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="17" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Concurrency Group" />
            <TextBox x:Name="ConcurrencyGroupTextBox" Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="18" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Group Importance" />
            <TextBox x:Name="ConcurrencyGroupImportanceTextBox" Grid.Row="18" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="19" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Importance" />
            <TextBox x:Name="ImportanceTextBox" Grid.Row="19" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="20" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Max In-Room Distance (px)" />
            <TextBox x:Name="MaxInRoomDistancePixelsTextBox" Grid.Row="20" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" ToolTip="Optional spatial emitter distance limit. Leave blank for no distance falloff." />

            <StackPanel Grid.Row="21" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
                <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
