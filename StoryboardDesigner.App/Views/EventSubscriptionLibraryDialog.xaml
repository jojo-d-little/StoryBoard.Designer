<Window x:Class="StoryboardDesigner.App.Views.EventSubscriptionLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Subscriptions"
        Height="560"
        Width="1120"
        MinHeight="540"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="#374151"
                   TextWrapping="Wrap"
                   Text="Review subscription coverage at a glance and open one subscription at a time for focused editing." />

        <DataGrid x:Name="SubscriptionsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  MouseDoubleClick="SubscriptionsDataGrid_OnMouseDoubleClick"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Subscription Name" Width="230" Binding="{Binding SubscriptionName, Mode=OneWay}" />
                <DataGridTextColumn Header="Event Key" Width="220" Binding="{Binding EventKey, Mode=OneWay}" />
                <DataGridCheckBoxColumn Header="Enabled" Width="75" Binding="{Binding IsEnabled, Mode=OneWay}" />
                <DataGridTextColumn Header="Lane" Width="120" Binding="{Binding Lane, Mode=OneWay}" />
                <DataGridTextColumn Header="Dispatch" Width="120" Binding="{Binding DispatchDisposition, Mode=OneWay}" />
                <DataGridTextColumn Header="Bindings" Width="90" Binding="{Binding BindingCount, Mode=OneWay}" />
                <DataGridTextColumn Header="First Action" Width="220" Binding="{Binding FirstActionName, Mode=OneWay}" />
                <DataGridTextColumn Header="Top Filter Variable" Width="190" Binding="{Binding TopFilterVariable, Mode=OneWay}" />
                <DataGridTextColumn Header="Id" Width="240" Binding="{Binding Id, Mode=OneWay}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="150" Margin="0,0,8,0" Content="Add Subscription" Click="AddSubscription_OnClick" />
            <Button Width="150" Margin="0,0,8,0" Content="Edit Subscription" Click="EditSubscription_OnClick" />
            <Button Width="160" Margin="0,0,18,0" Content="Remove Subscription" Click="RemoveSubscription_OnClick" />
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
