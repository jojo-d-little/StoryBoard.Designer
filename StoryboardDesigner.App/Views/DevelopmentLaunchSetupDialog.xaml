<Window x:Class="StoryboardDesigner.App.Views.DevelopmentLaunchSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Development WebPortal Setup"
        Height="250"
        Width="640"
        MinHeight="250"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Foreground="#6B7280"
                   Text="Development username (machine setting)" />
        <TextBox x:Name="DevelopmentUsernameTextBox"
                 Grid.Row="1"
                 Margin="0,4,0,0"
                 AutomationProperties.AutomationId="DevelopmentLaunchSetup.Username" />
        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"
                   Text="This username is passed as non-secret WebPortal bootstrap context for mode=devsimulator. Passwords and credential handles remain owned by GameHost and are not configured here." />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Width="84"
                    Margin="0,0,8,0"
                    Content="Save"
                    Click="Save_OnClick" />
            <Button Width="84"
                    Content="Cancel"
                    Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
