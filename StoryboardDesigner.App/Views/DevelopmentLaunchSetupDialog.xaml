<Window x:Class="StoryboardDesigner.App.Views.DevelopmentLaunchSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Development WebPortal Setup"
        Height="430"
        Width="640"
        MinHeight="430"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Foreground="#6B7280"
                   Text="Development username (machine setting)" />
        <TextBox x:Name="DevelopmentUsernameTextBox"
                 Grid.Row="1"
                 Margin="0,4,0,0"
                 AutomationProperties.AutomationId="DevelopmentLaunchSetup.Username" />

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#6B7280"
                   Text="GameHost executable path (machine setting, optional)" />
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="GameHostExecutablePathTextBox"
                     Grid.Column="0"
                     AutomationProperties.AutomationId="DevelopmentLaunchSetup.GameHostExecutablePath" />
            <Button Grid.Column="1"
                    Width="92"
                    Margin="8,0,0,0"
                    Content="Browse..."
                    Click="BrowseGameHost_OnClick" />
        </Grid>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="#6B7280"
                   Text="WebPortal root path (machine setting, optional)" />
        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WebPortalRootPathTextBox"
                     Grid.Column="0"
                     AutomationProperties.AutomationId="DevelopmentLaunchSetup.WebPortalRootPath" />
            <Button Grid.Column="1"
                    Width="92"
                    Margin="8,0,0,0"
                    Content="Browse..."
                    Click="BrowseWebPortal_OnClick" />
        </Grid>

        <TextBlock Grid.Row="6"
                   Margin="0,12,0,0"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"
                   Text="Leave either path blank to use automatic discovery or environment overrides. The WebPortal root must contain index.html. The username is non-secret bootstrap context; passwords and credential handles remain owned by GameHost." />

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Width="84"
                    Margin="0,0,8,0"
                    Content="Save"
                    Click="Save_OnClick" />
            <Button Width="84"
                    Content="Cancel"
                    Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
