<Window x:Class="StoryboardDesigner.App.Views.CreateProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="CreateProjectDialog.Window"
        Title="Create New Project"
        Height="360"
        Width="720"
        MinHeight="320"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="130" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">Project Name</TextBlock>
        <TextBox x:Name="ProjectNameTextBox"
             AutomationProperties.AutomationId="CreateProjectDialog.ProjectName"
             Grid.Row="0"
             Grid.Column="1"
             Grid.ColumnSpan="2"
             Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">Folder</TextBlock>
        <TextBox x:Name="ProjectFolderTextBox"
             AutomationProperties.AutomationId="CreateProjectDialog.ProjectFolder"
             Grid.Row="1"
             Grid.Column="1"
             Margin="0,0,8,12"
             IsReadOnly="True" />
        <Button Grid.Row="1"
            Grid.Column="2"
            Margin="0,0,0,12"
            AutomationProperties.AutomationId="CreateProjectDialog.Browse"
            Content="Browse..."
            Click="Browse_OnClick" />

        <TextBlock x:Name="StarterLabel"
                   Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,0,8,12"
                   VerticalAlignment="Center"
                   Visibility="Collapsed">Starter Project</TextBlock>
        <ComboBox x:Name="StarterComboBox"
                  AutomationProperties.AutomationId="CreateProjectDialog.StarterCombo"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,0,8,12"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="ProjectFilePath"
                  SelectionChanged="StarterComboBox_OnSelectionChanged"
                  Visibility="Collapsed" />
        <Button x:Name="BrowseStarterButton"
            AutomationProperties.AutomationId="CreateProjectDialog.BrowseStarter"
                Grid.Row="2"
                Grid.Column="2"
                Margin="0,0,0,12"
                Content="Browse Starter..."
                Click="BrowseStarter_OnClick"
                Visibility="Collapsed" />

        <TextBlock x:Name="StarterSelectionInfoTextBlock"
                   Grid.Row="3"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Margin="0,0,0,12"
                   Foreground="#1F2937"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <TextBlock x:Name="GameDisplayNameLabel"
                   Grid.Row="4"
                   Grid.Column="0"
                   Margin="0,0,8,12"
                   VerticalAlignment="Center"
                   Visibility="Collapsed">Game Display Name</TextBlock>
        <TextBox x:Name="GameDisplayNameTextBox"
             AutomationProperties.AutomationId="CreateProjectDialog.GameDisplayName"
                 Grid.Row="4"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Margin="0,0,0,12"
                 Visibility="Collapsed" />

        <TextBlock x:Name="GameSummaryLabel"
                   Grid.Row="5"
                   Grid.Column="0"
                   Margin="0,0,8,12"
                   VerticalAlignment="Center"
                   Visibility="Collapsed">Game Summary</TextBlock>
        <TextBox x:Name="GameSummaryTextBox"
             AutomationProperties.AutomationId="CreateProjectDialog.GameSummary"
                 Grid.Row="5"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Margin="0,0,0,12"
                 Visibility="Collapsed" />

        <TextBlock x:Name="GamePreviewImagesLabel"
                   Grid.Row="6"
                   Grid.Column="0"
                   Margin="0,0,8,12"
                   VerticalAlignment="Top"
                   Visibility="Collapsed">Game Preview Images</TextBlock>
        <TextBox x:Name="GamePreviewImagesTextBox"
             AutomationProperties.AutomationId="CreateProjectDialog.GamePreviewImages"
                 Grid.Row="6"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Margin="0,0,0,12"
                 Height="56"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Visibility="Collapsed" />

        <TextBlock x:Name="InstructionsTextBlock" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Foreground="#6B7280" TextWrapping="Wrap">
            A new folder named after the project will be created under the selected location.
        </TextBlock>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SubmitButton"
                    Width="84"
                    Margin="0,8,8,0"
                    AutomationProperties.AutomationId="CreateProjectDialog.Submit"
                    Content="Create"
                    Click="Create_OnClick" />
            <Button Width="84" Margin="0,8,0,0" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
