<Window x:Class="StoryboardDesigner.App.Views.ParticleEffectImageChoicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Particle Effect Artwork Overrides" Height="470" Width="700" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Width="85" Content="Add" Click="Add_OnClick" />
                <Button Width="85" Margin="6,0,0,0" Content="Remove" Click="Remove_OnClick" />
            </StackPanel>
            <ListBox x:Name="ChoicesListBox" DisplayMemberPath="DisplayName" SelectionChanged="ChoicesListBox_OnSelectionChanged" />
        </DockPanel>
        <StackPanel Grid.Column="1">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Artwork Override" />
            <TextBlock Margin="0,12,0,3" Text="Catalog effect" />
            <ComboBox x:Name="RecipeComboBox" DisplayMemberPath="DisplayName" SelectionChanged="RecipeComboBox_OnSelectionChanged" />
            <TextBlock Margin="0,12,0,3" Text="Image slot" />
            <ComboBox x:Name="ImageSlotComboBox" />
            <TextBlock Margin="0,12,0,3" Text="Project image path" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" Content="Browse..." Click="Browse_OnClick" />
                <TextBox x:Name="AssetPathTextBox" />
            </DockPanel>
            <TextBlock Margin="0,10,0,0" Foreground="#6B7280" TextWrapping="Wrap"
                       Text="Overrides are keyed by effect and declared image slot. PNG and WebP files are supported; clean export stages the selected asset." />
            <Button HorizontalAlignment="Left" Margin="0,14,0,0" Width="100" Content="Save Override" Click="SaveChoice_OnClick" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button Width="90" Content="Done" IsDefault="True" Click="Done_OnClick" />
        </StackPanel>
    </Grid>
</Window>
