<Window x:Class="StoryboardDesigner.App.Views.ParticleEffectObjectAuthoringDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Object Particle Effect" Height="620" Width="780"
        MinHeight="520" MinWidth="680" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Object Particle Effect" />
                <TextBlock Margin="0,4,0,8" Foreground="#4B5563" TextWrapping="Wrap"
                           Text="Select an object anchored recipe from the installed catalog. Controls are defined by the recipe family." />
                <CheckBox x:Name="HasEffectCheckBox" Content="Attach a particle effect" Checked="HasEffect_OnChanged" Unchecked="HasEffect_OnChanged" />
                <ComboBox x:Name="RecipeComboBox" Margin="0,6,0,8" DisplayMemberPath="DisplayName" SelectionChanged="RecipeComboBox_OnChanged" />
                <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="#4B5563" Text="Leave a value blank to use the recipe default. Choose a variable to override it dynamically." TextWrapping="Wrap" />
                <StackPanel x:Name="ControlsPanel" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button Width="90" Content="Save" IsDefault="True" Click="Save_OnClick" />
        </StackPanel>
    </Grid>
</Window>
