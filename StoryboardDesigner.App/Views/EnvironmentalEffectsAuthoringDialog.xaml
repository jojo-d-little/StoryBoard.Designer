<Window x:Class="StoryboardDesigner.App.Views.EnvironmentalEffectsAuthoringDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environmental Effects" Height="650" Width="760" MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Width="90" Content="Add" Click="Add_OnClick" />
                <Button Width="90" Margin="6,0,0,0" Content="Remove" Click="Remove_OnClick" />
            </StackPanel>
            <ListBox x:Name="EffectsListBox" DisplayMemberPath="Name" SelectionChanged="EffectsListBox_OnSelectionChanged" />
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Effect Definition" />
                <TextBlock Margin="0,10,0,3" Text="Name (the inherited name is replaced when overridden in a child scope)" />
                <TextBox x:Name="NameTextBox" />
                <TextBlock Margin="0,10,0,3" Text="Catalog recipe" />
                <ComboBox x:Name="RecipeComboBox" DisplayMemberPath="DisplayName" SelectionChanged="RecipeComboBox_OnSelectionChanged" />
                <TextBlock Margin="0,10,0,3" Text="Applicability" />
                <ComboBox x:Name="ApplicabilityComboBox" SelectedIndex="0">
                    <ComboBoxItem Content="Outdoor"/><ComboBoxItem Content="Indoor"/><ComboBoxItem Content="Both"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="EnabledCheckBox" Content="Enabled by default" IsChecked="True" />
                    <Button x:Name="BindEnabledButton" Margin="8,0,0,0" Padding="6,1" Content="Choose variable..." Click="BindEnabled_OnClick" />
                    <Button x:Name="ClearEnabledBindingButton" Margin="6,0,0,0" Padding="6,1" Content="Unbind" ToolTip="Remove the variable binding and use the authored Boolean fallback." Click="ClearEnabledBinding_OnClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center" Text="Render order" />
                    <TextBox x:Name="RenderOrderTextBox" Width="70" Margin="8,0,0,0" Text="0" />
                </StackPanel>
                <TextBlock Margin="0,14,0,2" FontWeight="SemiBold" Text="Recipe Controls" />
                <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="#4B5563" Text="Leave a value blank to use the recipe default. Choose a variable to override it dynamically." TextWrapping="Wrap" />
                <StackPanel x:Name="ControlsPanel" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button Width="90" Content="Done" IsDefault="True" Click="Done_OnClick" />
        </StackPanel>
    </Grid>
</Window>
