<Window x:Class="StoryboardDesigner.App.Views.GlobalSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global Settings"
        Height="800"
        Width="680"
        MinHeight="680"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Auto Save Seconds" />
        <TextBox x:Name="AutoSaveSecondsTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Starting Planet" />
        <ComboBox x:Name="StartingPlanetComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" IsEditable="False" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Player Character" />
        <ComboBox x:Name="PlayerCharacterComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" IsEditable="False" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Room Canvas Width" />
        <TextBox x:Name="RoomCanvasWidthTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" TextChanged="RoomCanvasDimensionTextBox_OnTextChanged" />

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Room Canvas Height" />
        <TextBox x:Name="RoomCanvasHeightTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" TextChanged="RoomCanvasDimensionTextBox_OnTextChanged" />

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Room Grid Cell Size" />
        <ComboBox x:Name="RoomGridCellSizeComboBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,12" IsEditable="False" />

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Stack Scale Step" ToolTip="Per-stack-level scale reduction amount. Example: 0.08 = 8% smaller per level." />
        <TextBox x:Name="StackScaleStepDefaultTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,12" ToolTip="Decimal scale step from 0.01 to 0.20." />

        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Min Stack Scale" ToolTip="Lower clamp for stacked-object scale after step reductions." />
        <TextBox x:Name="MinStackScaleDefaultTextBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,12" ToolTip="Decimal minimum stack scale from 0.25 to 1.00." />

        <GroupBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Header="Default Room Ambient Lighting" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Ambient intensity" ToolTip="Project default room ambient intensity from 0 to 1. Existing projects without this setting retain the legacy value of 1." />
                <TextBox x:Name="DefaultRoomAmbientIntensityTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,10" VerticalContentAlignment="Center" LostFocus="DefaultRoomAmbientIntensityTextBox_OnLostFocus" />
                <Slider x:Name="DefaultRoomAmbientIntensitySlider" Grid.Row="0" Grid.Column="2" Margin="0,0,8,10" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="DefaultRoomAmbientIntensitySlider_OnValueChanged" />
                <RepeatButton Grid.Row="0" Grid.Column="3" Margin="0,0,4,10" Content="−" Click="DefaultRoomAmbientIntensityDecrement_OnClick" />
                <RepeatButton Grid.Row="0" Grid.Column="4" Margin="0,0,0,10" Content="+" Click="DefaultRoomAmbientIntensityIncrement_OnClick" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Ambient color" />
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <Border x:Name="DefaultRoomAmbientColorPreview" Width="32" Height="24" Margin="0,0,8,0" BorderBrush="#6B7280" BorderThickness="1" />
                    <TextBox x:Name="DefaultRoomAmbientColorHexTextBox" Width="90" Margin="0,0,8,0" IsReadOnly="True" VerticalContentAlignment="Center" />
                    <Button Width="72" Margin="0,0,6,0" Content="Pick..." Click="PickDefaultRoomAmbientColor_OnClick" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Point Lighting" />
        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Width="140" Padding="12,4" Content="Manage Lighting" Click="ManageLighting_OnClick" />
            <TextBlock x:Name="LightingSummaryTextBlock" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#374151" />
        </StackPanel>

        <GroupBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Header="Default Room Sound Loss" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Loss (%)" />
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,4" Foreground="#4B5563" Text="Indoor" />
                    <TextBox x:Name="IndoorSoundLossPercentTextBox" ToolTip="Default amplitude loss in indoor rooms, from 0 to 100 percent." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Margin="0,0,0,4" Foreground="#4B5563" Text="Outdoor" />
                    <TextBox x:Name="OutdoorSoundLossPercentTextBox" ToolTip="Default amplitude loss in outdoor rooms, from 0 to 100 percent." />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,8,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Open-space loss per Area Map cell (%)" />
                <TextBox x:Name="OpenSpaceSoundLossPercentPerCellTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,10,8,0"
                         VerticalAlignment="Top"
                         ToolTip="Project-level attenuation applied once per unoccupied Area Map cell crossed by the sound's direct line. Enter 0 to disable, or a value from 0 to 100 percent." />
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="#4B5563"
                           Text="Applies once per unoccupied Area Map cell crossed by a sound's direct line. Empty cells add attenuation but do not block sound. Room cells use their indoor/outdoor default or room override. This is a project-level setting." />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Presentation" />
        <Button x:Name="ManagePresentationButton"
                Grid.Row="11"
                Grid.Column="1"
                HorizontalAlignment="Left"
                Padding="12,4"
                Margin="0,0,0,12"
                Content="Manage Presentation"
                Click="ManagePresentation_OnClick" />

        <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Sound Effects" />
        <Button x:Name="ManageSoundEffectsButton"
                Grid.Row="12"
                Grid.Column="1"
                HorizontalAlignment="Left"
                Padding="12,4"
                Margin="0,0,0,12"
                Content="Manage Sound Effects"
                Click="ManageSoundEffects_OnClick" />

        <StackPanel Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
