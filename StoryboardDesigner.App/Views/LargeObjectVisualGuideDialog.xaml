<Window x:Class="StoryboardDesigner.App.Views.LargeObjectVisualGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Large Object Visual Guide"
        Width="1100"
        Height="820"
        MinWidth="780"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="14" Text="Large Object Visual Guide" />

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D1D5DB" BorderThickness="1" Background="#F3F4F6" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="GuideSurfaceGrid" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <UniformGrid x:Name="GuideCellGrid" />
                        <Border x:Name="FootprintOverlay"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderBrush="#2563EB"
                                BorderThickness="2"
                                Background="#334F9DFF"
                                IsHitTestVisible="False" />
                        <Image x:Name="GuideImage" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.88" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle x:Name="BitmapBoundaryOverlay"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Stroke="#7C3AED"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="4,3"
                                   Opacity="0.8"
                                   IsHitTestVisible="False"
                                   RenderTransformOrigin="0.5,0.5" />
                        <Path x:Name="HeadingArrow"
                              Data="M 0 -32 L 9 -12 L 3 -12 L 3 20 L -3 20 L -3 -12 L -9 -12 Z"
                              Fill="#DC2626"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10" Background="#FFFFFF">
                <StackPanel>
                    <TextBlock x:Name="VariantCaption" FontWeight="SemiBold" Text="Selected variant" />
                    <TextBlock Margin="0,10,0,2" Text="Footprint (cells)" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FootprintWidthTextBox" Width="58" />
                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="×" />
                        <TextBox x:Name="FootprintHeightTextBox" Width="58" />
                        <Button Width="60" Margin="8,0,0,0" Content="Apply" Click="ApplyFootprintButton_OnClick" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,2" Text="Grid surface (cells)" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="GridColumnsTextBox" Width="58" />
                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="×" />
                        <TextBox x:Name="GridRowsTextBox" Width="58" />
                        <Button Width="60" Margin="8,0,0,0" Content="Apply" Click="ApplyGridButton_OnClick" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,12" Foreground="#6B7280" FontSize="11" Text="The initial surface uses the project room grid. Increasing it only enlarges this editor." TextWrapping="Wrap" />
                    <CheckBox x:Name="ShowBitmapBoundaryCheckBox"
                              Margin="0,0,0,12"
                              Content="Show bitmap boundary"
                              IsChecked="True"
                              Checked="ShowBitmapBoundaryCheckBox_OnChanged"
                              Unchecked="ShowBitmapBoundaryCheckBox_OnChanged"
                              ToolTip="Show the full rendered image rectangle, including transparent pixels." />

                    <TextBlock Text="Scale" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                        <Button Width="34" Content="−" Click="DecreaseScaleButton_OnClick" />
                        <TextBox x:Name="ScaleTextBox" Width="72" Margin="5,0" TextChanged="AlignmentTextBox_OnTextChanged" />
                        <Button Width="34" Content="+" Click="IncreaseScaleButton_OnClick" />
                    </StackPanel>
                    <TextBlock Text="Local Rotation" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                        <Button Width="34" Content="−15" Click="DecreaseRotationButton_OnClick" />
                        <TextBox x:Name="RotationTextBox" Width="72" Margin="5,0" TextChanged="AlignmentTextBox_OnTextChanged" />
                        <Button Width="34" Content="+15" Click="IncreaseRotationButton_OnClick" />
                    </StackPanel>
                    <TextBlock Text="Local Offset X" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                        <Button Width="34" Content="−" Click="DecreaseOffsetXButton_OnClick" />
                        <TextBox x:Name="OffsetXTextBox" Width="72" Margin="5,0" TextChanged="AlignmentTextBox_OnTextChanged" />
                        <Button Width="34" Content="+" Click="IncreaseOffsetXButton_OnClick" />
                    </StackPanel>
                    <TextBlock Text="Local Offset Y" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                        <Button Width="34" Content="−" Click="DecreaseOffsetYButton_OnClick" />
                        <TextBox x:Name="OffsetYTextBox" Width="72" Margin="5,0" TextChanged="AlignmentTextBox_OnTextChanged" />
                        <Button Width="34" Content="+" Click="IncreaseOffsetYButton_OnClick" />
                    </StackPanel>
                    <TextBlock x:Name="ImageMetricsTextBlock" Margin="0,10,0,0" Foreground="#374151" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusTextBlock" Margin="0,10,0,0" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Content="Close" Click="CloseButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
