<Window x:Class="StoryboardDesigner.App.Views.ObjectAppearanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Object Appearance"
        Width="740"
        Height="420"
        MinWidth="660"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8">Main Image</TextBlock>
        <TextBox x:Name="FullPathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" />
        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="PickFullImage_OnClick" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8">Gray Map</TextBlock>
        <TextBox x:Name="GrayPathTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" />
        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="PickGrayImage_OnClick" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8">Normal Map</TextBlock>
        <TextBox x:Name="NormalPathTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" />
        <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="PickNormalImage_OnClick" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8">Rotation (deg)</TextBlock>
        <TextBox x:Name="RotationTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,8" />

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">Scale</TextBlock>
        <TextBox x:Name="ScaleTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,0" />

        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,8,0">Local Offset X</TextBlock>
        <TextBox x:Name="LocalOffsetXTextBox" Grid.Row="5" Grid.Column="1" Margin="0,8,8,0" ToolTip="Shift image left/right in pixels within the footprint." />

        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,8,0">Local Offset Y</TextBlock>
        <TextBox x:Name="LocalOffsetYTextBox" Grid.Row="6" Grid.Column="1" Margin="0,8,8,0" ToolTip="Shift image up/down in pixels within the footprint." />

        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0" Background="#F9FAFB">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">Image Path Status</TextBlock>
                <TextBlock x:Name="FullPathHealthTextBlock" Foreground="#374151" TextWrapping="Wrap" />
                <TextBlock x:Name="GrayPathHealthTextBlock" Foreground="#374151" TextWrapping="Wrap" />
                <TextBlock x:Name="NormalPathHealthTextBlock" Foreground="#374151" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"
                           Text="If a source is missing, fallback may use project-source-images or exported assets. Use Tools > Source Image Management when relinking is needed." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
