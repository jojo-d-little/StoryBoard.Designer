<Window x:Class="StoryboardDesigner.App.Views.RoomTraversalsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Traversals"
        Height="460"
        Width="760"
        MinHeight="400"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <DataGrid x:Name="TraversalsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  Margin="0,0,0,10"
                  MouseDoubleClick="TraversalsDataGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Direction" Binding="{Binding DirectionLabel}" Width="120" />
                <DataGridTextColumn Header="Destination" Binding="{Binding DestinationRoomName}" Width="*" />
                <DataGridTextColumn Header="Door Link" Binding="{Binding DoorLinkSummary}" Width="220" />
                <DataGridTextColumn Header="From Passable Shared" Binding="{Binding FromPassableSharedSummary}" Width="140" />
                <DataGridTextColumn Header="To Passable Shared" Binding="{Binding ToPassableSharedSummary}" Width="140" />
                <DataGridTextColumn Header="Transition Effect" Binding="{Binding PresentationEffectSummary}" Width="170" />
                <DataGridTextColumn Header="Access" Binding="{Binding TraversalAccessMode}" Width="120" />
                <DataGridTextColumn Header="Open State" Binding="{Binding OpenStateBindingMode}" Width="130" />
                <DataGridTextColumn Header="Conn Id" Binding="{Binding TraversalConnectionId}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="110" Margin="0,0,8,0" Content="Add" Click="Add_OnClick" />
            <Button Width="110" Margin="0,0,8,0" Content="Edit" Click="EditSelected_OnClick" />
            <Button Width="120" Margin="0,0,8,0" Content="Relink Doors" Click="RelinkSelected_OnClick" />
            <Button Width="110" Margin="0,0,8,0" Content="Remove" Click="RemoveSelected_OnClick" />
            <Button Width="110" Content="Close" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
