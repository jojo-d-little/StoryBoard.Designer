<Window x:Class="StoryboardDesigner.App.Views.ManageGamePresentationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Presentation"
        Height="520"
        Width="700"
        MinHeight="520"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Game Display Name" />
        <TextBox x:Name="GameDisplayNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" MaxLength="120" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Top" Text="Game Summary" />
        <TextBox x:Name="GameSummaryTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 MinHeight="88"
                 MaxLength="2000"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Preview Images" />

        <Grid Grid.Row="2" Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,0,8"
                       Foreground="#374151"
                       Text="Entries are source image paths. Export stages them to assets/images/previewImages." />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="PreviewImagesListBox"
                         Grid.Column="0"
                         Margin="0,0,12,0"
                         MinHeight="180" />

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                    <Button Width="110" Margin="0,0,0,8" Content="Browse Add" Click="BrowseAdd_OnClick" />
                    <TextBox x:Name="ManualPathTextBox"
                             Width="180"
                             Margin="0,0,0,8"
                             ToolTip="Paste a path then click Add Path" />
                    <Button Width="110" Margin="0,0,0,8" Content="Add Path" Click="AddManual_OnClick" />
                    <Button Width="110" Margin="0,0,0,8" Content="Remove" Click="Remove_OnClick" />
                    <Button Width="110" Margin="0,0,0,8" Content="Move Up" Click="MoveUp_OnClick" />
                    <Button Width="110" Content="Move Down" Click="MoveDown_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
