<Window x:Class="StoryboardDesigner.App.Views.AreaPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Area Settings"
        Height="390"
        Width="520"
        MinHeight="390"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Name" />
        <TextBox x:Name="AreaNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Adjacency Mode" />
        <ComboBox x:Name="AdjacencyModeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />

           <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Auto-connect On Drop" />
           <ComboBox x:Name="RoomDropBehaviorComboBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     DisplayMemberPath="Name" />

           <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Starting Room" />
        <ComboBox x:Name="StartingRoomComboBox"
                   Grid.Row="3"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  IsEditable="False" />

              <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Top" Text="Producer Notes" />
            <TextBox x:Name="ProducerNotesTextBox"
                  Grid.Row="4"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 MinHeight="64"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" />

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Foreground="#6B7280" TextWrapping="Wrap"
                    Text="Choose which room should be the area entry point. Leave blank if the area currently has no rooms. You can also control whether dropped rooms auto-create adjacent traversals or stay wizard/disconnected first." />

              <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
