<Window x:Class="StoryboardDesigner.App.Views.PhaseNodeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase Settings"
        Height="960"
        Width="700"
        MinHeight="880"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Tier" />
        <TextBlock x:Name="TierTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Display Name" />
        <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Phase Key" />
        <TextBox x:Name="PhaseKeyTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Title" />
        <TextBox x:Name="TitleTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Title Cue" />
        <ComboBox x:Name="TitleCueComboBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  DisplayMemberPath="Display"
                  SelectedValuePath="EffectKey"
                  IsEditable="True" />

        <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Header="Ambient Sound" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Ambient Sound" />
                <ComboBox x:Name="AmbientSoundComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Margin="0,0,0,10"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Id" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Ambient Timer Key" />
                <ComboBox x:Name="AmbientTimerKeyComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,0,10"
                          IsEditable="True"
                          StaysOpenOnEdit="True" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Ambient Mode" />
                <ComboBox x:Name="AmbienceModeComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Header="Phase Ambient Lighting" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="PhaseAmbientLightingEnabledCheckBox"
                          Grid.Row="0"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="0,0,0,8"
                          Content="Use custom phase ambient overlay"
                          ToolTip="Author a phase-specific contribution to the room ambient lighting. Page values take precedence over chapter values at runtime."
                          Checked="PhaseAmbientLightingEnabledCheckBox_OnChanged"
                          Unchecked="PhaseAmbientLightingEnabledCheckBox_OnChanged" />

                <TextBlock x:Name="PhaseAmbientLightingHelpTextBlock"
                           Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,8"
                           Foreground="#4B5563"
                           TextWrapping="Wrap"
                           Text="Scale multiplies the room ambient baseline. Override uses the selected color; Blend mixes it using the blend amount. Leave the overlay unchecked to inherit the room ambient unchanged." />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Ambient scale" ToolTip="Multiplier applied to the room ambient intensity. Valid range is 0 to 2; 1 leaves the room intensity unchanged." />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PhaseAmbientScaleTextBox" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" LostFocus="PhaseAmbientScaleTextBox_OnLostFocus" ToolTip="Enter a multiplier from 0 to 2, or leave blank to omit the authored scale." />
                    <Slider x:Name="PhaseAmbientScaleSlider" Grid.Column="1" Margin="0,0,8,0" Minimum="0" Maximum="2" TickFrequency="0.1" SmallChange="0.05" LargeChange="0.5" IsSnapToTickEnabled="False" ValueChanged="PhaseAmbientScaleSlider_OnValueChanged" ToolTip="Common range: 0 to 2. A value of 1 preserves room ambient intensity." />
                    <RepeatButton Grid.Column="2" Margin="0,0,4,0" Content="−" Click="PhaseAmbientScaleDecrement_OnClick" ToolTip="Decrease by 0.05" />
                    <RepeatButton Grid.Column="3" Content="+" Click="PhaseAmbientScaleIncrement_OnClick" ToolTip="Increase by 0.05" />
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Color mode" ToolTip="Override replaces the inherited ambient color; Blend mixes the selected color with the inherited color." />
                <ComboBox x:Name="PhaseAmbientColorModeComboBox"
                          Grid.Row="3"
                          Grid.Column="1"
                          Margin="0,0,0,10"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectionChanged="PhaseAmbientColorModeComboBox_OnSelectionChanged" />

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Overlay color" ToolTip="Optional six-digit #RRGGBB color used by the selected color mode." />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border x:Name="PhaseAmbientColorPreview" Width="32" Height="24" Margin="0,0,8,0" BorderBrush="#6B7280" BorderThickness="1" />
                    <TextBox x:Name="PhaseAmbientColorHexTextBox" Width="90" Margin="0,0,8,0" IsReadOnly="True" VerticalContentAlignment="Center" />
                    <Button x:Name="PickPhaseAmbientColorButton" Width="72" Margin="0,0,6,0" Content="Pick..." Click="PickPhaseAmbientColor_OnClick" />
                    <Button x:Name="ClearPhaseAmbientColorButton" Width="60" Content="Clear" Click="ClearPhaseAmbientColor_OnClick" />
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Color blend" ToolTip="Blend amount from 0 to 1. Only applies when Color mode is Blend." />
                <Grid Grid.Row="5" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PhaseAmbientColorBlendTextBox" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" LostFocus="PhaseAmbientColorBlendTextBox_OnLostFocus" ToolTip="Enter a blend amount from 0 to 1, or leave blank to omit it." />
                    <Slider x:Name="PhaseAmbientColorBlendSlider" Grid.Column="1" Margin="0,0,8,0" Minimum="0" Maximum="1" TickFrequency="0.1" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="False" ValueChanged="PhaseAmbientColorBlendSlider_OnValueChanged" ToolTip="Common range: 0 to 1." />
                    <RepeatButton Grid.Column="2" Margin="0,0,4,0" Content="−" Click="PhaseAmbientColorBlendDecrement_OnClick" ToolTip="Decrease by 0.05" />
                    <RepeatButton Grid.Column="3" Content="+" Click="PhaseAmbientColorBlendIncrement_OnClick" ToolTip="Increase by 0.05" />
                </Grid>

                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,10,8,0" VerticalAlignment="Center" Text="Transition duration (ms)" ToolTip="Leave blank to inherit. Zero applies the lighting target immediately." />
                <TextBox x:Name="PhaseAmbientTransitionDurationTextBox" Grid.Row="6" Grid.Column="1" Margin="0,10,0,0" VerticalContentAlignment="Center" ToolTip="Milliseconds; blank inherits, zero is immediate." />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Time of day" />
            <ComboBox x:Name="TimeOfDayComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Time of year" />
            <ComboBox x:Name="TimeOfYearComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Weather" />
            <Button x:Name="ManageWeatherButton" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Padding="12,4" Content="Manage Weather..." Click="ManageWeather_OnClick" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Top" Text="Prologue" />
            <TextBox x:Name="PrologueTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                      Margin="0,0,0,12"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" />

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Prologue Cue" />
            <ComboBox x:Name="PrologueCueComboBox"
                      Grid.Row="4"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Display"
                      SelectedValuePath="EffectKey"
                      IsEditable="True" />

            <CheckBox x:Name="PairTitleAndPrologueCueCheckBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      Content="Pair title + prologue as one presentation step using Title Cue"
                      Checked="PairTitleAndPrologueCueCheckBox_OnCheckedChanged"
                      Unchecked="PairTitleAndPrologueCueCheckBox_OnCheckedChanged" />

            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Top" Text="Narrative" />
            <TextBox x:Name="NarrativeTextBox"
                     Grid.Row="6"
                     Grid.Column="1"
                      Margin="0,0,0,12"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" />

            <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Narrative Cue" />
            <ComboBox x:Name="NarrativeCueComboBox"
                      Grid.Row="7"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Display"
                      SelectedValuePath="EffectKey"
                      IsEditable="True" />
        </Grid>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
