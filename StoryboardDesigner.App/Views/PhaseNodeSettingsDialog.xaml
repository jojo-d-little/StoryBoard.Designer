<Window x:Class="StoryboardDesigner.App.Views.PhaseNodeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase Settings"
        Height="700"
        Width="700"
        MinHeight="700"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Tier" />
        <TextBlock x:Name="TierTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Display Name" />
        <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Phase Key" />
        <TextBox x:Name="PhaseKeyTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Title" />
        <TextBox x:Name="TitleTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Title Cue" />
        <ComboBox x:Name="TitleCueComboBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  DisplayMemberPath="Display"
                  SelectedValuePath="EffectKey"
                  IsEditable="True" />

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Ambience Sound" />
        <ComboBox x:Name="AmbientSoundComboBox"
                  Grid.Row="5"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  DisplayMemberPath="Display"
                  SelectedValuePath="Id" />

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Ambience Timer Key" />
        <ComboBox x:Name="AmbientTimerKeyComboBox"
              Grid.Row="6"
              Grid.Column="1"
              Margin="0,0,0,12"
              IsEditable="True"
              StaysOpenOnEdit="True" />

        <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Ambience Mode" />
            <ComboBox x:Name="AmbienceModeComboBox"
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Top" Text="Prologue" />
            <TextBox x:Name="PrologueTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                      Margin="0,0,0,12"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Prologue Cue" />
            <ComboBox x:Name="PrologueCueComboBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Display"
                      SelectedValuePath="EffectKey"
                      IsEditable="True" />

            <CheckBox x:Name="PairTitleAndPrologueCueCheckBox"
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      Content="Pair title + prologue as one presentation step using Title Cue"
                      Checked="PairTitleAndPrologueCueCheckBox_OnCheckedChanged"
                      Unchecked="PairTitleAndPrologueCueCheckBox_OnCheckedChanged" />

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Top" Text="Narrative" />
            <TextBox x:Name="NarrativeTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                      Margin="0,0,0,12"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" />

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Narrative Cue" />
            <ComboBox x:Name="NarrativeCueComboBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Display"
                      SelectedValuePath="EffectKey"
                      IsEditable="True" />
        </Grid>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
