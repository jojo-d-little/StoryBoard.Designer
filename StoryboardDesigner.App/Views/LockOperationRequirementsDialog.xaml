<Window x:Class="StoryboardDesigner.App.Views.LockOperationRequirementsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lock Requirements"
        Width="1080"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   Foreground="#374151"
                   TextWrapping="Wrap"
                   Text="Define participants first, then configure settings per selected participant. This follows the same participant-first workflow used in Procedures." />

        <GroupBox Grid.Row="1" Header="Unlock Participants" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="UnlockParticipantsListBox"
                         DisplayMemberPath="ParticipantSummary"
                         SelectionChanged="UnlockParticipantsListBox_OnSelectionChanged" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button Width="96" Margin="0,0,8,0" Content="Add" Click="AddUnlockParticipant_OnClick" />
                    <Button Width="96" Margin="0,0,8,0" Content="Remove" Click="RemoveUnlockParticipant_OnClick" />
                    <Button Width="96" Content="Clear" Click="ClearUnlockParticipants_OnClick" />
                </StackPanel>

                <Border Grid.Row="2" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Participant Object" />
                        <ComboBox x:Name="UnlockParticipantObjectComboBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="0,0,14,8"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="UnlockParticipantField_OnChanged" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,10,8" VerticalAlignment="Center" Text="Quantity" />
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="UnlockParticipantQuantityTextBox"
                                     Width="96"
                                     Margin="0,0,8,0"
                                     TextChanged="UnlockParticipantField_OnChanged"
                                     PreviewTextInput="NumberTextBox_OnPreviewTextInput"
                                     DataObject.Pasting="NumberTextBox_OnPasting" />
                            <CheckBox x:Name="UnlockParticipantOptionalCheckBox"
                                      VerticalAlignment="Center"
                                      Content="Optional"
                                      Checked="UnlockParticipantField_OnChanged"
                                      Unchecked="UnlockParticipantField_OnChanged" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Match Kind" />
                        <ComboBox x:Name="UnlockParticipantMatchKindComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,0,14,8"
                                  IsEnabled="False"
                                  SelectionChanged="UnlockParticipantField_OnChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,10,8" VerticalAlignment="Center" Text="Match Value" Visibility="Collapsed" />
                        <TextBox x:Name="UnlockParticipantMatchValueTextBox"
                                 Grid.Row="1"
                                 Grid.Column="3"
                                 Margin="0,0,0,8"
                                 Visibility="Collapsed"
                                 TextChanged="UnlockParticipantField_OnChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,10,8" VerticalAlignment="Center" Text="Consumption" />
                        <ComboBox x:Name="UnlockParticipantConsumptionComboBox"
                                  Grid.Row="1"
                                  Grid.Column="3"
                                  Margin="0,0,0,8"
                                  SelectionChanged="UnlockParticipantField_OnChanged" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="Satisfaction" />
                        <ComboBox x:Name="UnlockParticipantSatisfactionComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,0,14,0"
                                  SelectionChanged="UnlockParticipantField_OnChanged" />
                        <Button Grid.Row="2"
                                Grid.Column="3"
                                MinWidth="210"
                                Padding="12,4"
                                HorizontalAlignment="Right"
                            Content="Game Property Requirements"
                                Click="EditUnlockParticipantVariables_OnClick" />
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Lock Participants" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="RequireKeyForLockOperationCheckBox"
                              Margin="0,0,12,0"
                              Content="Require key for LockObject"
                              Checked="RequireKeyForLockOperationCheckBox_OnChanged"
                              Unchecked="RequireKeyForLockOperationCheckBox_OnChanged" />
                    <CheckBox x:Name="UseUnlockKeysForLockOperationCheckBox"
                              Content="Use same participants as UnlockObject"
                              Checked="UseUnlockKeysForLockOperationCheckBox_OnChanged"
                              Unchecked="UseUnlockKeysForLockOperationCheckBox_OnChanged" />
                </StackPanel>

                <ListBox x:Name="LockParticipantsListBox"
                         Grid.Row="1"
                         DisplayMemberPath="ParticipantSummary"
                         SelectionChanged="LockParticipantsListBox_OnSelectionChanged" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button x:Name="AddLockParticipantButton" Width="96" Margin="0,0,8,0" Content="Add" Click="AddLockParticipant_OnClick" />
                    <Button x:Name="RemoveLockParticipantButton" Width="96" Margin="0,0,8,0" Content="Remove" Click="RemoveLockParticipant_OnClick" />
                    <Button x:Name="ClearLockParticipantsButton" Width="96" Content="Clear" Click="ClearLockParticipants_OnClick" />
                </StackPanel>

                <Border Grid.Row="3" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Participant Object" />
                        <ComboBox x:Name="LockParticipantObjectComboBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="0,0,14,8"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="LockParticipantField_OnChanged" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,10,8" VerticalAlignment="Center" Text="Quantity" />
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="LockParticipantQuantityTextBox"
                                     Width="96"
                                     Margin="0,0,8,0"
                                     TextChanged="LockParticipantField_OnChanged"
                                     PreviewTextInput="NumberTextBox_OnPreviewTextInput"
                                     DataObject.Pasting="NumberTextBox_OnPasting" />
                            <CheckBox x:Name="LockParticipantOptionalCheckBox"
                                      VerticalAlignment="Center"
                                      Content="Optional"
                                      Checked="LockParticipantField_OnChanged"
                                      Unchecked="LockParticipantField_OnChanged" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Match Kind" />
                        <ComboBox x:Name="LockParticipantMatchKindComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,0,14,8"
                                  IsEnabled="False"
                                  SelectionChanged="LockParticipantField_OnChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,10,8" VerticalAlignment="Center" Text="Match Value" Visibility="Collapsed" />
                        <TextBox x:Name="LockParticipantMatchValueTextBox"
                                 Grid.Row="1"
                                 Grid.Column="3"
                                 Margin="0,0,0,8"
                                 Visibility="Collapsed"
                                 TextChanged="LockParticipantField_OnChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,10,8" VerticalAlignment="Center" Text="Consumption" />
                        <ComboBox x:Name="LockParticipantConsumptionComboBox"
                                  Grid.Row="1"
                                  Grid.Column="3"
                                  Margin="0,0,0,8"
                                  SelectionChanged="LockParticipantField_OnChanged" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="Satisfaction" />
                        <ComboBox x:Name="LockParticipantSatisfactionComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,0,14,0"
                                  SelectionChanged="LockParticipantField_OnChanged" />
                        <Button x:Name="EditLockParticipantVariablesButton"
                                Grid.Row="2"
                                Grid.Column="3"
                                MinWidth="210"
                                Padding="12,4"
                                HorizontalAlignment="Right"
                            Content="Game Property Requirements"
                                Click="EditLockParticipantVariables_OnClick" />
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="96" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="96" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
