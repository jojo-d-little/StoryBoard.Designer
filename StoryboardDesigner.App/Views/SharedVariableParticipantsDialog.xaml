<Window x:Class="StoryboardDesigner.App.Views.SharedVariableParticipantsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shared Variable Details"
        Height="460"
        Width="900"
        MinHeight="340"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="DisplayNameTextBlock"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Text="Shared Variable" />
            <TextBlock x:Name="IdTextBlock"
                       Margin="0,4,0,0"
                       Foreground="#4B5563"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <TextBlock Text="Default: " FontWeight="SemiBold" />
            <TextBlock x:Name="DefaultValueTextBlock" Margin="0,0,18,0" />
            <TextBlock Text="Restriction: " FontWeight="SemiBold" />
            <TextBlock x:Name="ValueRestrictionTextBlock" />
        </StackPanel>

        <Grid Grid.Row="2">
            <DataGrid x:Name="ParticipantsDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Participant" Binding="{Binding Endpoint}" Width="3*" />
                    <DataGridTextColumn Header="Object / Scope" Binding="{Binding OwnerDisplayName}" Width="3*" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                    <DataGridTextColumn Header="Owner ID" Binding="{Binding OwnerId}" Width="2*" />
                    <DataGridTextColumn Header="Property" Binding="{Binding VariableName}" Width="2*" />
                    <DataGridTextColumn Header="Leg" Binding="{Binding Leg}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyParticipantsTextBlock"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#6B7280"
                       Text="This shared variable has no participant records." />
        </Grid>

        <Button Grid.Row="3"
                Width="90"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Content="Close"
                IsDefault="True"
                IsCancel="True"
                Click="Close_OnClick" />
    </Grid>
</Window>
