<Window x:Class="StoryboardDesigner.App.Views.ObjectImageVariantsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Object Appearance"
        Width="920"
        Height="980"
        MinWidth="820"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="14" Text="Object Appearance" />
        <TextBlock Grid.Row="1" Margin="0,4,0,0" Foreground="#4B5563" FontSize="11" TextWrapping="Wrap"
                   Text="Manage appearance: shape, orientation, heading guidance, and named image variants in one place." />

        <Border Grid.Row="2" Margin="0,10,0,0" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="IsMovableCheckBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Movable" ToolTip="Enables movement interactions and movement-related state for this object." />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Movable Default" ToolTip="Default authored value for the isMovable game property." />
                    <ComboBox x:Name="MovableDefaultValueComboBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsEnabled="{Binding IsChecked, ElementName=IsMovableCheckBox}" ToolTip="Starting movable state for this object.">
                        <ComboBoxItem Content="false" />
                        <ComboBoxItem Content="true" />
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Footprint Width" ToolTip="Number of occupied cells across the footprint width." />
                    <TextBox x:Name="FootprintWidthTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" ToolTip="Positive integer width in grid cells." PreviewTextInput="WholeNumberTextBox_OnPreviewTextInput" DataObject.Pasting="WholeNumberTextBox_OnPasting" TextChanged="FootprintDimensionTextBox_OnTextChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Footprint Height" ToolTip="Number of occupied cells across the footprint height." />
                    <TextBox x:Name="FootprintHeightTextBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" ToolTip="Positive integer height in grid cells." PreviewTextInput="WholeNumberTextBox_OnPreviewTextInput" DataObject.Pasting="WholeNumberTextBox_OnPasting" TextChanged="FootprintDimensionTextBox_OnTextChanged" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Footprint Orientation" ToolTip="Cardinal orientation for the object's footprint shape." />
                    <ComboBox x:Name="FootprintOrientationComboBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" ToolTip="Cardinal footprint orientation (N/E/S/W)." SelectionChanged="FootprintOrientationComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="N" />
                        <ComboBoxItem Content="E" />
                        <ComboBoxItem Content="S" />
                        <ComboBoxItem Content="W" />
                    </ComboBox>

                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Heading Direction" ToolTip="Facing direction used as the authored object heading." />
                    <ComboBox x:Name="HeadingDirectionComboBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" ToolTip="Eight-way heading direction." SelectionChanged="HeadingDirectionComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="N" />
                        <ComboBoxItem Content="NE" />
                        <ComboBoxItem Content="E" />
                        <ComboBoxItem Content="SE" />
                        <ComboBoxItem Content="S" />
                        <ComboBoxItem Content="SW" />
                        <ComboBoxItem Content="W" />
                        <ComboBoxItem Content="NW" />
                    </ComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Spatial Type" ToolTip="SolidObject participates in collisions/stacking. PassiveObject is floor-integrated and ignored by stacking/collision logic." />
                    <ComboBox x:Name="SpatialTypeComboBox" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" ToolTip="Choose SolidObject or PassiveObject runtime behavior." SelectionChanged="SpatialTypeComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="SolidObject" />
                        <ComboBoxItem Content="PassiveObject" />
                    </ComboBox>

                    <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Stack Group" ToolTip="Stack compatibility tier. 0 = not stackable. Lower positive values can stack on equal or higher values (example: 1 can stack on 2)." />
                    <TextBox x:Name="StackOrderTextBox" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" ToolTip="Non-negative integer. 0 = not stackable. For values > 0, lower numbers can stack on equal or higher numbers." PreviewTextInput="WholeNumberTextBox_OnPreviewTextInput" DataObject.Pasting="WholeNumberTextBox_OnPasting" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Object Height Units" ToolTip="Non-negative integer used for vertical occupancy and stack math. Use 0 for floor-like supports that add no stack height." />
                    <TextBox x:Name="ObjectHeightUnitsTextBox" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" ToolTip="Non-negative integer. Minimum 0." PreviewTextInput="WholeNumberTextBox_OnPreviewTextInput" DataObject.Pasting="WholeNumberTextBox_OnPasting" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Height In Room" ToolTip="Non-negative vertical offset for this object in room coordinates." />
                    <TextBox x:Name="HeightInRoomTextBox" Grid.Row="9" Grid.Column="1" Margin="0,8,0,0" ToolTip="Non-negative integer room offset." PreviewTextInput="WholeNumberTextBox_OnPreviewTextInput" DataObject.Pasting="WholeNumberTextBox_OnPasting" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Stack Scale Step" ToolTip="Optional per-object scale step override when stacked." />
                    <TextBox x:Name="StackScaleStepOverrideTextBox" Grid.Row="10" Grid.Column="1" Margin="0,8,0,0" ToolTip="Optional decimal from 0.01 to 0.20. Leave blank to use project default." PreviewTextInput="OptionalDecimalTextBox_OnPreviewTextInput" DataObject.Pasting="OptionalDecimalTextBox_OnPasting" />
                    
                    <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Min Stack Scale" ToolTip="Optional per-object minimum scale clamp." />
                    <TextBox x:Name="MinStackScaleOverrideTextBox" Grid.Row="11" Grid.Column="1" Margin="0,8,0,0" ToolTip="Optional decimal from 0.25 to 1.00. Leave blank to use project default." PreviewTextInput="OptionalDecimalTextBox_OnPreviewTextInput" DataObject.Pasting="OptionalDecimalTextBox_OnPasting" />

                </Grid>


                <Border Grid.Column="2" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="8" Background="#F9FAFB">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Footprint + Heading Visual Guide" />

                        <Grid x:Name="GuideSurfaceGrid" Grid.Row="1" Margin="0,8,0,0" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UniformGrid x:Name="FootprintGuideGrid" Rows="7" Columns="7" />
                            <Border x:Name="GuideFootprintOverlay"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    BorderBrush="#2563EB"
                                    BorderThickness="2"
                                    Background="#334F9DFF"
                                    CornerRadius="2"
                                    IsHitTestVisible="False" />
                            <Image x:Name="GuideImageOverlay" Width="88" Height="88" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.88" RenderTransformOrigin="0.5,0.5" />
                            <Path x:Name="GuideHeadingArrow"
                                  Data="M 0 -32 L 9 -12 L 3 -12 L 3 20 L -3 20 L -3 -12 L -9 -12 Z"
                                  Fill="#DC2626"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="1.2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5" />
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="RotateLeftButton" Width="86" Height="26" Content="Rotate Left" Margin="0,0,8,0" Click="RotateLeftButton_OnClick" ToolTip="Rotate heading 45° counterclockwise." />
                            <Button x:Name="RotateRightButton" Width="90" Height="26" Content="Rotate Right" Click="RotateRightButton_OnClick" ToolTip="Rotate heading 45° clockwise." />
                        </StackPanel>

                        <TextBlock x:Name="GuideLegendTextBlock"
                                   Grid.Row="3"
                                   Margin="0,8,0,0"
                                   Foreground="#4B5563"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   ToolTip="Legend for how footprint orientation and heading are represented in the guide." />

                        <StackPanel Grid.Row="4" Margin="0,8,0,0">
                            <TextBlock x:Name="GuideVariantFitCaptionTextBlock"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Text="Selected variant: none" />

                            <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Scale" ToolTip="Scale multiplier applied to the selected image variant." />
                                <TextBox x:Name="GuideVariantScaleTextBox"
                                         Width="64"
                                         Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter a positive decimal scale (for example: 0.8, 1.0, 1.25)."
                                         TextChanged="GuideVariantScaleTextBox_OnTextChanged"
                                         KeyDown="GuideVariantFitTextBox_OnKeyDown" />
                                <Button x:Name="DecreaseVariantScaleButton" Width="32" Height="24" Margin="0,0,4,0" Content="-" Click="DecreaseVariantScaleButton_OnClick" ToolTip="Decrease selected variant scale by 0.01." />
                                <Button x:Name="IncreaseVariantScaleButton" Width="32" Height="24" Content="+" Click="IncreaseVariantScaleButton_OnClick" ToolTip="Increase selected variant scale by 0.01." />
                            </WrapPanel>

                            <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Local Rotation" ToolTip="Variant-local rotation in degrees used to align this image to the footprint cell shape." />
                                <TextBox x:Name="GuideVariantRotationTextBox"
                                         Width="64"
                                         Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter variant-local rotation in degrees (for example: -15, 0, 45)."
                                         KeyDown="GuideVariantFitTextBox_OnKeyDown" />
                                <Button x:Name="DecreaseVariantRotationButton" Width="40" Height="24" Margin="0,0,4,0" Content="-15" Click="DecreaseVariantRotationButton_OnClick" ToolTip="Rotate 15° counterclockwise." />
                                <Button x:Name="IncreaseVariantRotationButton" Width="40" Height="24" Margin="0,0,6,0" Content="+15" Click="IncreaseVariantRotationButton_OnClick" ToolTip="Rotate 15° clockwise." />
                            </WrapPanel>

                            <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Local Offset X" ToolTip="Shift selected image left/right in local preview space." />
                                <TextBox x:Name="GuideVariantOffsetXTextBox"
                                         Width="64"
                                         Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter variant-local X offset in pixels (for example: -6, 0, 8)."
                                         KeyDown="GuideVariantFitTextBox_OnKeyDown" />
                                <Button x:Name="DecreaseVariantOffsetXButton" Width="32" Height="24" Margin="0,0,4,0" Content="-" Click="DecreaseVariantOffsetXButton_OnClick" ToolTip="Shift left by 1 pixel." />
                                <Button x:Name="IncreaseVariantOffsetXButton" Width="32" Height="24" Margin="0,0,8,0" Content="+" Click="IncreaseVariantOffsetXButton_OnClick" ToolTip="Shift right by 1 pixel." />

                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Local Offset Y" ToolTip="Shift selected image up/down in local preview space." />
                                <TextBox x:Name="GuideVariantOffsetYTextBox"
                                         Width="64"
                                         Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter variant-local Y offset in pixels (for example: -6, 0, 8)."
                                         KeyDown="GuideVariantFitTextBox_OnKeyDown" />
                                <Button x:Name="DecreaseVariantOffsetYButton" Width="32" Height="24" Margin="0,0,4,0" Content="-" Click="DecreaseVariantOffsetYButton_OnClick" ToolTip="Shift up by 1 pixel." />
                                <Button x:Name="IncreaseVariantOffsetYButton" Width="32" Height="24" Margin="0,0,6,0" Content="+" Click="IncreaseVariantOffsetYButton_OnClick" ToolTip="Shift down by 1 pixel." />
                                <Button x:Name="ApplyVariantFitButton" Width="54" Height="24" Content="Apply" Click="ApplyVariantFitButton_OnClick" ToolTip="Apply scale, rotation, and local offset changes to the selected variant preview." />
                            </WrapPanel>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>


        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Variants" />

                    <ListBox x:Name="ImageVariantListBox"
                             Grid.Row="1"
                             Margin="0,8,0,0"
                             SelectionChanged="ImageVariantListBox_OnSelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding VariantName}" />
                                    <Border Grid.Column="1" Background="#DBEAFE" CornerRadius="3" Padding="5,1,5,1" Margin="8,0,0,0">
                                        <TextBlock Text="default" Foreground="#1D4ED8" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                        <Button x:Name="AddVariantButton" Width="72" Height="26" Content="Add" Click="AddVariantButton_OnClick" />
                        <Button x:Name="RemoveVariantButton" Width="72" Height="26" Margin="8,0,0,0" Content="Remove" Click="RemoveVariantButton_OnClick" />
                        <Button x:Name="SetDefaultVariantButton" Width="84" Height="26" Margin="8,0,0,0" Content="Default" Click="SetDefaultVariantButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Variant Name" />
                    <TextBox x:Name="VariantNameTextBox" Grid.Row="0" Grid.Column="1" MinWidth="220" />
                    <Button x:Name="RenameVariantButton" Grid.Row="0" Grid.Column="2" Width="86" Margin="8,0,0,0" Content="Rename" Click="RenameVariantButton_OnClick" />

                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="EditSelectedAppearanceButton" Width="168" Height="28" Content="Edit Selected Appearance..." Click="EditSelectedAppearance_OnClick" />
                        <Button x:Name="MoveVariantUpButton" Width="74" Height="28" Margin="8,0,0,0" Content="Move Up" Click="MoveVariantUpButton_OnClick" />
                        <Button x:Name="MoveVariantDownButton" Width="88" Height="28" Margin="8,0,0,0" Content="Move Down" Click="MoveVariantDownButton_OnClick" />
                    </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,12,8,0" VerticalAlignment="Top" Text="Chooser" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <Button x:Name="EditChooserScriptButton"
                            Width="186"
                            Height="28"
                            HorizontalAlignment="Left"
                            Content="Edit Chooser Script..."
                            Click="EditChooserScriptButton_OnClick" />
                        <TextBox x:Name="ImageVariantChooserScriptTextBox"
                             Margin="0,8,0,0"
                             MinHeight="72"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             Background="#F9FAFB"
                             BorderBrush="#D1D5DB"
                             ToolTip="Use Edit Chooser Script to update chooser logic with guided variable and variant-name insertion." />
                        </StackPanel>

                    <TextBlock x:Name="ImageVariantValidationHintTextBlock"
                               Grid.Row="3"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Margin="0,6,0,0"
                               Foreground="#B45309"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8">
                        <Grid>
                            <Image x:Name="AppearanceThumbnailImage" Stretch="Uniform" />
                            <TextBlock x:Name="AppearanceNoImageTextBlock" Text="No Image" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
