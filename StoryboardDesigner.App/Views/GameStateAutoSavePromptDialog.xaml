<Window x:Class="StoryboardDesigner.App.Views.GameStateAutoSavePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Initialize Game State"
        Height="210"
        Width="560"
        MinHeight="210"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#111827" TextWrapping="Wrap">
            You have unsaved changes. Do you want to auto save before initializing game state?
        </TextBlock>

        <CheckBox x:Name="DoNotAskAgainCheckBox"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  Content="Do not ask again for this app run" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="150" Margin="0,0,8,0" Content="Auto Save and Initialize" Click="AutoSave_OnClick" />
            <Button Width="170" Margin="0,0,8,0" Content="Initialize Without Saving" Click="WithoutSave_OnClick" />
            <Button Width="84" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
