<Window x:Class="StoryboardDesigner.App.Views.TextOutputScriptEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StoryboardDesigner.App.Views.Controls"
        Title="Edit Message Script"
        Height="520"
        Width="860"
        MinHeight="420"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
            <TextBlock TextWrapping="Wrap" Foreground="#374151"
                       Text="Message Script: use IF/ELSE IF/ELSE with ECHO lines and close each IF block with ENDIF. Type { for variable references and @ for built-in functions (@ALL, @ANY, @NOT, @hasItem). Quick { suggestions include self.* and action.*; choose 'Choose variable...' in the popup to browse all variables." />
        </Border>

        <Expander Grid.Row="1"
                  Margin="0,0,0,10"
                  Header="Available Variables"
                  IsExpanded="False">
            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Background="#FFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                    <ItemsControl x:Name="AvailableVariableGroupsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="10,0,0,6">
                                                    <TextBlock Text="{Binding Token}" Foreground="#111827" />
                                                    <TextBlock Text="{Binding Description}" Foreground="#4B5563" FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Example}" Foreground="#6B7280" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>

        <controls:ActionScriptTextEditor x:Name="ScriptEditor" Grid.Row="2" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="92" Margin="0,0,8,0" Content="Validate" Click="Validate_OnClick" />
            <Button Width="92" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="92" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
