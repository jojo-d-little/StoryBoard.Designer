<Window x:Class="StoryboardDesigner.App.Views.ManageWeatherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Weather" Height="430" Width="520" MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Sky condition"/><ComboBox x:Name="SkyConditionComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Precipitation"/><ComboBox x:Name="PrecipitationComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Weather intensity"/><ComboBox x:Name="WeatherIntensityComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Temperature"/><ComboBox x:Name="TemperatureComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Storming"/><ComboBox x:Name="StormingComboBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Wind direction" ToolTip="-1 means no wind. 0° is east; angles increase clockwise."/><TextBox x:Name="WindDirectionTextBox" Grid.Row="5" Grid.Column="1" VerticalContentAlignment="Center" ToolTip="Leave blank to inherit; use -1 for no wind or 0–359 degrees."/>
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick"/><Button Width="100" Content="Cancel" Click="Cancel_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
