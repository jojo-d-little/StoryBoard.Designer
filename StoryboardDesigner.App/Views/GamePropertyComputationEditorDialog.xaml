<Window x:Class="StoryboardDesigner.App.Views.GamePropertyComputationEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computed Game Property" Height="700" Width="860" MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" Text="Result type"/>
            <ComboBox x:Name="ResultKindComboBox" Width="160" SelectionChanged="ResultKindComboBox_OnChanged">
                <ComboBoxItem Content="Boolean"/><ComboBoxItem Content="Numeric"/><ComboBoxItem Content="String"/>
            </ComboBox>
        </DockPanel>
        <Grid Grid.Row="1">
            <StackPanel x:Name="BooleanPanel">
                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Text="Boolean computations return the condition result directly. Existing Boolean computations remain unchanged."/>
                <Button x:Name="EditBooleanConditionButton" Width="190" HorizontalAlignment="Left" Padding="10,5" Content="Edit condition tree..." Click="EditBooleanCondition_OnClick"/>
                <TextBlock x:Name="BooleanConditionTextBlock" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#374151"/>
            </StackPanel>
            <Grid x:Name="ResultPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" TextWrapping="Wrap" Text="Branches are evaluated in order. The first matching condition returns its result; the required else result is used when none match."/>
                <ListBox x:Name="BranchesListBox" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" DisplayMemberPath="Label" SelectionChanged="BranchesListBox_OnSelectionChanged"/>
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,10">
                    <Button x:Name="AddBranchButton" Margin="0,0,6,0" Padding="8,4" Content="Add branch" Click="AddBranch_OnClick"/>
                    <Button x:Name="MoveBranchUpButton" Margin="0,0,6,0" Padding="8,4" Content="Move up" Click="MoveBranchUp_OnClick"/>
                    <Button x:Name="MoveBranchDownButton" Margin="0,0,6,0" Padding="8,4" Content="Move down" Click="MoveBranchDown_OnClick"/>
                    <Button x:Name="RemoveBranchButton" Padding="8,4" Content="Remove" Click="RemoveBranch_OnClick"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold" Text="Selected branch" Margin="0,0,0,8"/>
                    <TextBlock Text="Condition"/>
                    <DockPanel Margin="0,4,0,12">
                        <Button x:Name="EditBranchConditionButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,4" Content="Edit..." Click="EditBranchCondition_OnClick"/>
                        <TextBox x:Name="BranchConditionTextBox" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock Text="Result"/>
                    <CheckBox x:Name="BranchUsesPropertyCheckBox" Margin="0,5,0,6" Content="Use another game property" Checked="BranchOutputMode_OnChanged" Unchecked="BranchOutputMode_OnChanged"/>
                    <DockPanel x:Name="BranchSourcePanel" Margin="0,0,0,10" IsEnabled="False">
                        <Button x:Name="ChooseBranchSourceButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,4" Content="Choose..." Click="ChooseBranchSource_OnClick"/>
                        <TextBox x:Name="BranchSourceTextBox" IsReadOnly="True"/>
                    </DockPanel>
                    <StackPanel x:Name="BranchLiteralPanel">
                        <TextBlock Text="Typed literal"/>
                        <TextBox x:Name="BranchLiteralTextBox" Margin="0,4,0,10" TextChanged="BranchLiteralTextBox_OnChanged"/>
                    </StackPanel>
                </StackPanel>
                <GroupBox Grid.Row="3" Grid.ColumnSpan="2" Header="Else result">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="ElseUsesPropertyCheckBox" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Content="Property" Checked="ElseOutputMode_OnChanged" Unchecked="ElseOutputMode_OnChanged"/>
                        <TextBox x:Name="ElseLiteralTextBox" Grid.Column="1" Margin="0,0,8,0" TextChanged="ElseLiteralTextBox_OnChanged"/>
                        <TextBlock x:Name="ElseSourceTextBlock" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="ChooseElseSourceButton" Grid.Column="2" Margin="0,0,8,0" Padding="8,4" Content="Choose..." Click="ChooseElseSource_OnClick" Visibility="Collapsed"/>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#6B7280" Text="Required fallback output"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Width="90" Margin="0,0,8,0" Content="Save" Click="Save_OnClick"/>
            <Button x:Name="CancelButton" Width="90" Content="Cancel" Click="Cancel_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
