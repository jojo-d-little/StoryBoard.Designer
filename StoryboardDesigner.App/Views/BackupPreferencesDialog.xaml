<Window x:Class="StoryboardDesigner.App.Views.BackupPreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Backups"
        Height="300"
        Width="620"
        MinHeight="280"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,12" VerticalAlignment="Center" Text="Backup interval (hours)" />
        <TextBox x:Name="BackupIntervalHoursTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" AutomationProperties.AutomationId="BackupPreferences.IntervalHours" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,12" VerticalAlignment="Center" Text="Maximum backups per project" />
        <TextBox x:Name="MaximumBackupCountTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" AutomationProperties.AutomationId="BackupPreferences.MaximumBackupCount" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="Backup folder" />
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BackupRootPathTextBox" Grid.Column="0" AutomationProperties.AutomationId="BackupPreferences.RootPath" />
            <Button Grid.Column="1" Width="88" Margin="8,0,0,0" Content="Browse..." Click="Browse_OnClick" />
        </Grid>

        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0" Foreground="#4B5563" TextWrapping="Wrap"
                   Text="Backups are stored outside project folders. The interval must be between 2 and 24 hours; retention is the maximum number of ZIP files kept for each project. The default folder is under your local application data." />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="84" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" IsDefault="True" />
            <Button Width="84" Content="Cancel" Click="Cancel_OnClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
