<Window x:Class="StoryboardDesigner.App.Views.ScopedTokenListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Scoped List"
        Height="480"
        Width="620"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#111827" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,4"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   Text="Inherited from parent scopes (read only)" />

        <ListBox x:Name="InheritedTokensListBox"
                 Grid.Row="2"
                 MinHeight="90"
                 BorderBrush="#D1D5DB"
                 BorderThickness="1"
                 Background="#F9FAFB">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Foreground="#4B5563" Text="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,10,0,8">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,2" Content="Add" Click="AddToken_OnClick" />
            <TextBox x:Name="TokenInputTextBox" VerticalAlignment="Center" KeyDown="TokenInputTextBox_OnKeyDown" />
        </DockPanel>

        <TextBlock x:Name="TokenInputFeedbackText"
               Grid.Row="4"
               Margin="0,0,0,6"
               Foreground="#B45309"
               Visibility="Collapsed"
               TextWrapping="Wrap" />

        <Border x:Name="DirectionalMappingPanel"
            Grid.Row="5"
                Margin="0,0,0,8"
                Padding="8"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Background="#F9FAFB"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Text="Optional traversal-direction mapping" />

                <ComboBox x:Name="DirectionalTokenComboBox"
                          Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,0,8,0"
                          IsEditable="False" />

                <ComboBox x:Name="TraversalDirectionComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,8,0"
                          IsEditable="False" />

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Padding="10,2"
                        Content="Set"
                        Click="SetDirectionalMapping_OnClick" />

                <ListBox x:Name="DirectionalMappingsPreviewListBox"
                         Grid.Row="2"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         MaxHeight="96"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Background="#F3F4F6"
                         SelectionChanged="DirectionalMappingsPreviewListBox_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="#4B5563" Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Margin="8,8,0,0"
                            VerticalAlignment="Top">
                    <Button x:Name="LoadMappingButton"
                            Margin="0,0,0,6"
                            Padding="10,2"
                            Content="Load"
                            IsEnabled="False"
                            Click="LoadSelectedDirectionalMapping_OnClick" />
                    <Button x:Name="RemoveMappingButton"
                            Padding="10,2"
                            Content="Remove"
                            IsEnabled="False"
                            Click="RemoveSelectedDirectionalMapping_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ListBox x:Name="TokensListBox" Grid.Row="6">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right"
                                Width="28"
                                Height="24"
                                Margin="8,0,0,0"
                                Padding="0"
                                FontSize="14"
                                Content="-"
                                Click="RemoveToken_OnClick" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
