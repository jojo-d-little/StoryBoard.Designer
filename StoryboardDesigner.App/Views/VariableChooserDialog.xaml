<Window x:Class="StoryboardDesigner.App.Views.VariableChooserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Game Property"
        Height="520"
        Width="760"
        MinHeight="420"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ReferenceModePanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Reference as:" />
            <ComboBox x:Name="ReferenceModeComboBox" Width="190" SelectionChanged="ReferenceMode_OnChanged">
                <ComboBoxItem Content="Fixed" />
                <ComboBoxItem Content="Owner relative" />
                <ComboBoxItem Content="Anchor" />
            </ComboBox>
            <TextBlock x:Name="AnchorLabel" Margin="14,0,8,0" VerticalAlignment="Center" Text="Anchor:" Visibility="Collapsed" />
            <ComboBox x:Name="AnchorComboBox" Width="190" Visibility="Collapsed" SelectionChanged="Anchor_OnChanged" />
            <TextBlock x:Name="ReferencePreviewTextBlock" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#4B5563" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,3" Foreground="#4B5563" Text="Filter by scope" />
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,3" Foreground="#4B5563" Text="Filter by property" />
            <ComboBox x:Name="ScopeFilterComboBox"
                     Grid.Row="1"
                     Grid.Column="0"
                     Margin="0,0,6,0"
                     DisplayMemberPath="Label"
                     SelectedValuePath="Value"
                     ToolTip="Show results for one object or scope"
                     SelectionChanged="ScopeFilterComboBox_OnSelectionChanged" />
            <ComboBox x:Name="PropertyFilterComboBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,0"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      ToolTip="Show results for one property name"
                      SelectionChanged="PropertyFilterComboBox_OnSelectionChanged" />
        </Grid>

        <Grid x:Name="ScopeOptionsPanel"
              Grid.Row="1"
              Margin="0,0,0,8"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="IncludeSelfCheckBox"
                      Grid.Row="0" Grid.Column="0" Margin="0,0,12,6"
                      Content="Self"
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludeChildrenCheckBox"
                      Grid.Row="1" Grid.Column="0" Margin="0,0,12,6"
                      Content="Children"
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludeDescendantsCheckBox"
                      Grid.Row="2" Grid.Column="0" Margin="0,0,12,6"
                      Content="Descendants"
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludeAncestorsCheckBox"
                      Grid.Row="0" Grid.Column="1" Margin="0,0,12,6"
                      Content="Ancestors"
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludeParentCheckBox"
                      Grid.Row="1" Grid.Column="1" Margin="0,0,12,6"
                      Content="Parents"
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludeSiblingsCheckBox"
                      Grid.Row="2" Grid.Column="1" Margin="0,0,12,6"
                      Content="Siblings"
                      ToolTip="Include objects or scopes with the same immediate parent. For room objects, this includes other objects in the room and traversals connected to that room."
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludeGlobalCheckBox"
                      Grid.Row="0" Grid.Column="2" Margin="0,0,12,6"
                      Content="Global"
                      ToolTip="Include global properties and owners. Global results are also included when Ancestors is checked."
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludePhaseVariablesCheckBox"
                      Grid.Row="1" Grid.Column="2" Margin="0,0,12,6"
                      Content="Phase"
                      ToolTip="Include variables owned by phase books, chapters, and pages."
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludeTraversalLegsCheckBox"
                      Grid.Row="2" Grid.Column="2" Margin="0,0,12,6"
                      Content="Traversals"
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
            <CheckBox x:Name="IncludeOtherScopesCheckBox"
                      Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"
                      Content="Unrelated"
                      ToolTip="Include properties owned outside this hierarchy that are not global or phase properties."
                      Checked="ScopeOptions_OnChanged"
                      Unchecked="ScopeOptions_OnChanged" />
        </Grid>

        <DataGrid x:Name="ChoicesDataGrid"
                  Grid.Row="3"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="ChoicesDataGrid_OnSelectionChanged"
                  MouseDoubleClick="ChoicesDataGrid_OnMouseDoubleClick"
                  PreviewKeyDown="ChoicesDataGrid_OnPreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Scope"
                                    Binding="{Binding ScopePath}"
                                    SortMemberPath="ScopePath"
                                    Width="*" />
                <DataGridTextColumn Header="Owner.Variable"
                                    Binding="{Binding OwnerVariable}"
                                    SortMemberPath="OwnerVariable"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ChoiceEmptyTextBlock"
                   Grid.Row="3"
                   Margin="12,36,12,12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#6B7280"
                   TextAlignment="Center"
                   MaxWidth="520"
                   TextWrapping="Wrap"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Select" Click="Select_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
