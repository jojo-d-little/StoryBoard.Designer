<Window x:Class="StoryboardDesigner.App.Views.ActionEchoEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action Echo Editor"
        Height="560"
        Width="900"
        MinHeight="460"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Border Padding="10" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                <TextBlock TextWrapping="Wrap" Foreground="#374151"
                           Text="Edit outcome echo scripts by result code. Supported codes are driven by the runtime registry. Unsupported imported codes are preserved as inert entries." />
            </Border>
            <Border x:Name="UnsupportedWarningBorder"
                    Margin="0,8,0,0"
                    Padding="10"
                    Background="#FEF3C7"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <TextBlock x:Name="UnsupportedWarningText" TextWrapping="Wrap" Foreground="#92400E" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="6" Background="#FFFFFF">
                <ListView x:Name="EntriesListView"
                          SelectionChanged="EntriesListView_OnSelectionChanged"
                          MouseDoubleClick="EntriesListView_OnMouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Result Code" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Token}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="#6B7280"
                                                       Text="{Binding OutcomeLabel}"
                                                       ToolTip="{Binding SupportHint}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Echo Script (first line)" Width="560">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ScriptPreview, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 BorderBrush="#D1D5DB"
                                                 BorderThickness="1"
                                                 Background="#F9FAFB"
                                                 Padding="6,2"
                                                 Cursor="Hand"
                                                 ToolTip="Click to edit this result-code echo script."
                                                 PreviewMouseLeftButtonUp="EchoScriptPreview_OnPreviewMouseLeftButtonUp" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="92" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="92" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
