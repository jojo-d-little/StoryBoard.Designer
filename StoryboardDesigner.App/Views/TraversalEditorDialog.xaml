<Window x:Class="StoryboardDesigner.App.Views.TraversalEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StoryboardDesigner.App.ViewModels"
        Title="Edit Traversal"
        Height="520"
        Width="500"
        MinHeight="420"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Mode" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="GuidedModeRadioButton"
                             Content="Guided"
                             Margin="0,0,16,0"
                             IsChecked="True"
                             Checked="ModeRadioButton_OnChecked" />
                <RadioButton x:Name="UnguidedModeRadioButton"
                             Content="Unguided"
                             Checked="ModeRadioButton_OnChecked" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="From Room" />
            <ComboBox x:Name="RoomAComboBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectionChanged="RoomComboBox_OnSelectionChanged"
                      IsEditable="False" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Direction" />
            <ComboBox x:Name="DirectionComboBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      SelectionChanged="DirectionComboBox_OnSelectionChanged" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="To Room" />
            <ComboBox x:Name="RoomBComboBox"
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectionChanged="RoomComboBox_OnSelectionChanged"
                      IsEditable="False" />

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Access Mode" />
            <ComboBox x:Name="TraversalAccessModeComboBox"
                      Grid.Row="4"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding Source={x:Static vm:TraversalAccessModeValues.All}}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Open State Mode" />
            <ComboBox x:Name="OpenStateBindingModeComboBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding Source={x:Static vm:OpenStateBindingModeValues.All}}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="A -&gt; B Open Rule" />
            <ComboBox x:Name="OpenStatePolicyFromAComboBox"
                      Grid.Row="6"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding Source={x:Static vm:OpenablePolicyValues.All}}" />

            <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="B -&gt; A Open Rule" />
            <ComboBox x:Name="OpenStatePolicyFromBComboBox"
                      Grid.Row="7"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding Source={x:Static vm:OpenablePolicyValues.All}}" />

            <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="From Room Door" />
            <ComboBox x:Name="FromRoomDoorComboBox"
                      Grid.Row="8"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Label"
                      SelectedValuePath="ObjectId"
                      IsEditable="False" />

            <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="To Room Door" />
            <ComboBox x:Name="ToRoomDoorComboBox"
                      Grid.Row="9"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Label"
                      SelectedValuePath="ObjectId"
                      IsEditable="False" />

            <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Transition Effect" />
            <ComboBox x:Name="PresentationEffectKeyComboBox"
                      Grid.Row="10"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Label"
                      SelectedValuePath="EffectKey"
                      IsEditable="False"
                      ToolTip="Optional presentation effect key used by host transition rendering cues." />

            <TextBlock Grid.Row="11"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Text="Guided mode limits directions to adjacent map rooms and auto-selects destination by direction. Unguided allows any room and direction." />

            <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Width="96" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
                <Button Width="96" Content="Cancel" Click="Cancel_OnClick" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
