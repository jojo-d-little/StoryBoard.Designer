                               Text="Sound Effect"
                               ToolTip="Select the sound effect this PlaySoundEffect action should emit." />
                    <ComboBox x:Name="PlaySoundEffectChoiceComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              DisplayMemberPath="DisplayName"
                              ToolTip="Scoped sound effects available to this action." />

                    <TextBlock x:Name="PlaySoundEffectSelectionHintTextBlock"
                               Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               Text="The selected sound is stored on the Success result-code cue for this action." />
                </Grid>

                <TextBlock x:Name="NotImplementedPanel"
                           Visibility="Collapsed"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Text="This action type is part of the MVP list, but its detailed fields are not implemented in the editor yet." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="92" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="92" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
