<Window x:Class="StoryboardDesigner.App.Views.RoomActionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StoryboardDesigner.App.ViewModels"
        Title="Edit Room Action"
        Height="980"
        Width="980"
        MinHeight="900"
        MinWidth="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Action Name" ToolTip="Friendly name used by designers to identify this game action in editors." />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Action Type" ToolTip="Defines what this action does at runtime, such as echo, property checks, or composite build/break." />
        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding Source={x:Static vm:CommandActionTypeValues.All}}"
                  SelectedItem="{Binding ActionType, Mode=TwoWay}" />

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <CheckBox x:Name="ForwardToChildrenCheckBox"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Content="Forward command to children"
                      ToolTip="When enabled, child objects are also given a chance to handle the same command."
                      Checked="ForwardToChildrenCheckBox_OnChanged"
                      Unchecked="ForwardToChildrenCheckBox_OnChanged" />
            <ComboBox x:Name="ForwardingModeComboBox"
                      Width="280"
                      IsEnabled="False"
                      SelectionChanged="ForwardingModeComboBox_OnSelectionChanged" />
            <ComboBox x:Name="SimilarChildDispatchModeComboBox"
                      Width="220"
                      Margin="12,0,0,0"
                      IsEnabled="False"
                      ToolTip="Choose whether forwarded execution runs a single matching similar child or all matching similar children."
                      SelectionChanged="SimilarChildDispatchModeComboBox_OnSelectionChanged" />
        </StackPanel>

        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Padding="10" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Background="#FFFFFF" Margin="0,0,0,12">
            <TabControl>
                <TabItem Header="Result Code Echo Scripts">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,0,0,8"
                                   Foreground="#374151"
                                   Text="Result-code echo scripts: click a script preview to edit that entry." />

                        <Border x:Name="OutcomeEchoUnsupportedWarningBorder"
                                Grid.Row="1"
                                Margin="0,0,0,8"
                                Padding="10"
                                Background="#FEF3C7"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <TextBlock x:Name="OutcomeEchoUnsupportedWarningText" TextWrapping="Wrap" Foreground="#92400E" />
                        </Border>

                        <ListView x:Name="OutcomeEchoEntriesListView"
                                  Grid.Row="2"
                                  MinHeight="360"
                                  SelectionChanged="OutcomeEchoEntriesListView_OnSelectionChanged"
                                  MouseDoubleClick="OutcomeEchoEntriesListView_OnMouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Result Code" Width="260">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Token}" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="#6B7280"
                                                               Text="{Binding OutcomeLabel}"
                                                               ToolTip="{Binding SupportHint}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Echo Script (first line)" Width="640">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ScriptPreview, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         BorderBrush="#D1D5DB"
                                                         BorderThickness="1"
                                                         Background="#F9FAFB"
                                                         Padding="6,2"
                                                         Cursor="Hand"
                                                         ToolTip="Click to edit this result-code echo script."
                                                         PreviewMouseLeftButtonUp="OutcomeEchoScriptPreview_OnPreviewMouseLeftButtonUp" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
                <TabItem Header="Result Code Sound Effects">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,0,0,8"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"
                                   Text="Assign one or more sound-effect cues to each action result code. Use scope filters and search to browse current, parent, and child scope sound libraries." />

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Result Code" />
                            <ComboBox x:Name="OutcomeSoundResultCodeComboBox"
                                      Grid.Column="1"
                                      MinWidth="220"
                                      SelectionChanged="OutcomeSoundResultCodeComboBox_OnSelectionChanged" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="8" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#FFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Margin="0,0,0,6" Foreground="#374151" Text="Assigned Cues" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OutcomeSoundCueStatusTextBlock"
                                               Grid.Row="0"
                                               Margin="130,0,0,6"
                                               Foreground="#6B7280"
                                               Text="Select a result code to edit cues." />
                                    <ListView x:Name="OutcomeSoundCueEntriesListView"
                                              Grid.Row="1"
                                              MinHeight="220"
                                              SelectionChanged="OutcomeSoundCueEntriesListView_OnSelectionChanged">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Index}" />
                                                <GridViewColumn Header="Enabled" Width="70" DisplayMemberBinding="{Binding EnabledText}" />
                                                <GridViewColumn Header="Lane" Width="90" DisplayMemberBinding="{Binding LaneText}" />
                                                <GridViewColumn Header="Sound" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
                                                <GridViewColumn Header="Scope" Width="140" DisplayMemberBinding="{Binding ScopeCategoryText}" />
                                                <GridViewColumn Header="Hint" Width="180" DisplayMemberBinding="{Binding HintText}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Hint" />
                                            <TextBox x:Name="OutcomeSoundCueHintTextBox" Width="210" />
                                            <TextBlock VerticalAlignment="Center" Margin="10,0,8,0" Text="Lane" />
                                            <TextBlock x:Name="OutcomeSoundCueLaneTextBlock" Width="100" VerticalAlignment="Center" Text="sfx" />
                                            <CheckBox x:Name="OutcomeSoundCueEnabledCheckBox" Margin="12,0,0,0" VerticalAlignment="Center" Content="Enabled" />
                                        </StackPanel>

                                        <Button x:Name="OutcomeSoundApplyCueButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,2" Content="Apply" Click="OutcomeSoundApplyCueChanges_OnClick" />
                                        <Button x:Name="OutcomeSoundMoveCueUpButton" Grid.Column="2" Margin="8,0,0,0" Padding="10,2" Content="Up" Click="OutcomeSoundMoveCueUp_OnClick" />
                                        <Button x:Name="OutcomeSoundMoveCueDownButton" Grid.Column="3" Margin="8,0,0,0" Padding="10,2" Content="Down" Click="OutcomeSoundMoveCueDown_OnClick" />
                                        <Button x:Name="OutcomeSoundRemoveCueButton" Grid.Column="4" Margin="8,0,0,0" Padding="10,2" Content="Remove" Click="OutcomeSoundRemoveCue_OnClick" />
                                    </Grid>

                                    <TextBlock x:Name="OutcomeSoundUnresolvedWarningTextBlock"
                                               Grid.Row="2"
                                               Margin="0,34,0,0"
                                               Foreground="#92400E"
                                               Visibility="Collapsed"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Padding="8" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#F9FAFB">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Margin="0,0,0,6" Foreground="#374151" Text="Scoped Sound Library" FontWeight="SemiBold" />

                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="OutcomeSoundScopeFilterComboBox"
                                                  Grid.Column="0"
                                                  Margin="0,0,8,0"
                                                  SelectionChanged="OutcomeSoundChoiceFilter_OnChanged" />
                                        <TextBox x:Name="OutcomeSoundSearchTextBox"
                                                 Grid.Column="1"
                                                 TextChanged="OutcomeSoundChoiceFilter_OnChanged"
                                                 ToolTip="Search by key, name, category, scope path, or asset ref." />
                                    </Grid>

                                    <ListView x:Name="OutcomeSoundChoicesListView"
                                              Grid.Row="2"
                                              MinHeight="220"
                                              MouseDoubleClick="OutcomeSoundChoicesListView_OnMouseDoubleClick">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding DisplayName}" />
                                                <GridViewColumn Header="Key" Width="130" DisplayMemberBinding="{Binding SoundEffectKey}" />
                                                <GridViewColumn Header="Source" Width="100" DisplayMemberBinding="{Binding SourceCategory}" />
                                                <GridViewColumn Header="Scope" Width="160" DisplayMemberBinding="{Binding ScopePath}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="OutcomeSoundAddSelectedChoiceButton" Width="120" Content="Add Selected" Click="OutcomeSoundAddSelectedChoice_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Margin="0,8,0,0"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Text="Tip: choose a result code first, then double-click a scoped sound effect entry (or use Add Selected) to append a cue." />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border x:Name="ActionSpecificEditorBorder" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Padding="10" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Background="#F9FAFB" Visibility="Collapsed">
            <Grid>
                <Grid x:Name="EchoTextEditorPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1" Visibility="Collapsed">
                        <TextBox x:Name="EchoTextEditorTextBox"
                                 Visibility="Collapsed"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 PreviewTextInput="EchoTextEditorTextBox_OnPreviewTextInput"
                                 PreviewKeyDown="EchoTextEditorTextBox_OnPreviewKeyDown"
                                 TextChanged="EchoTextEditorTextBox_OnTextChanged"
                                 Text="{Binding EchoMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Popup x:Name="EchoReferencePopup"
                               Placement="Center"
                               PlacementTarget="{Binding ElementName=EchoTextEditorTextBox}"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="280" MaxHeight="180">
                                <ListBox x:Name="EchoReferenceListBox"
                                         MouseDoubleClick="EchoReferenceListBox_OnMouseDoubleClick"
                                         PreviewKeyDown="EchoReferenceListBox_OnPreviewKeyDown" />
                            </Border>
                        </Popup>
                        <Popup x:Name="EchoFunctionPopup"
                               Placement="Center"
                               PlacementTarget="{Binding ElementName=EchoTextEditorTextBox}"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="320" MaxHeight="200">
                                <ListBox x:Name="EchoFunctionListBox"
                                         MouseDoubleClick="EchoFunctionListBox_OnMouseDoubleClick"
                                         PreviewKeyDown="EchoFunctionListBox_OnPreviewKeyDown" />
                            </Border>
                        </Popup>
                        <Popup x:Name="EchoReturnPopup"
                               Placement="Center"
                               PlacementTarget="{Binding ElementName=EchoTextEditorTextBox}"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="300" MaxHeight="180">
                                <ListBox x:Name="EchoReturnListBox"
                                         MouseDoubleClick="EchoReturnListBox_OnMouseDoubleClick"
                                         PreviewKeyDown="EchoReturnListBox_OnPreviewKeyDown" />
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <Grid x:Name="FlagEditorPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Flag Name" ToolTip="Choose a true/false game property to test for this action." />
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,0,8,10"
                             IsReadOnly="True"
                             Text="{Binding FlagName, Mode=OneWay}" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,0,10"
                            Padding="10,2"
                            Content="Choose..."
                            Click="ChooseFlagVariable_OnClick" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Flag Value" ToolTip="Expected boolean value required for this check to pass." />
                    <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" IsChecked="{Binding FlagValue, Mode=TwoWay}" Content="True" />
                </Grid>

                <Grid x:Name="VariableEditorPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Game Property" ToolTip="Property to assign when this action runs." />
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,0,8,10"
                             IsReadOnly="True"
                             Text="{Binding GamePropertyName, Mode=OneWay}" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,0,10"
                            Padding="10,2"
                            Content="Choose..."
                            Click="ChooseSetVariable_OnClick" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Value" ToolTip="Value expression to assign to the selected property." />
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                        <TextBox x:Name="VariableValueEditorTextBox"
                                 PreviewTextInput="VariableValueEditorTextBox_OnPreviewTextInput"
                                 PreviewKeyDown="VariableValueEditorTextBox_OnPreviewKeyDown"
                                 TextChanged="VariableValueEditorTextBox_OnTextChanged"
                                 Text="{Binding GamePropertyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox x:Name="VariableValueBooleanComboBox"
                                  Visibility="Collapsed"
                                  SelectedItem="{Binding GamePropertyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Popup x:Name="VariableReferencePopup"
                               Placement="Center"
                               PlacementTarget="{Binding ElementName=VariableValueEditorTextBox}"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="280" MaxHeight="180">
                                <ListBox x:Name="VariableReferenceListBox"
                                         MouseDoubleClick="VariableReferenceListBox_OnMouseDoubleClick"
                                         PreviewKeyDown="VariableReferenceListBox_OnPreviewKeyDown" />
                            </Border>
                        </Popup>
                        <Popup x:Name="VariableFunctionPopup"
                               Placement="Center"
                               PlacementTarget="{Binding ElementName=VariableValueEditorTextBox}"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="320" MaxHeight="200">
                                <ListBox x:Name="VariableFunctionListBox"
                                         MouseDoubleClick="VariableFunctionListBox_OnMouseDoubleClick"
                                         PreviewKeyDown="VariableFunctionListBox_OnPreviewKeyDown" />
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <Grid x:Name="PutObjectInContainerEditorPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Margin="0,0,0,10"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Text="Container target is resolved from the command secondary object (for example: put key in knapsack)." />
                </Grid>

                <Grid x:Name="MoveRoomObjectOnGridEditorPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Margin="0,0,0,10"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Text="Move only applies to objects with isMovable=true. Set Movable from Object Properties or Manage Appearance." />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Direction Override" ToolTip="Optional. Leave blank to move using the actor's current heading." />
                    <ComboBox x:Name="MoveDirectionOverrideComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Text="{Binding MoveDirectionToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Optional direction token (for example: north, east, up)." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Distance (Cells)" ToolTip="Number of cells to move when the action succeeds." />
                    <TextBox x:Name="MoveDistanceTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center"
                             Text="{Binding MoveDistanceInCells, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Transition Hint" ToolTip="Host-side visual speed/style hint for movement presentation." />
                    <ComboBox x:Name="MoveVisualTransitionHintComboBox"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              SelectedItem="{Binding MoveVisualTransitionHint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Partial Movement" ToolTip="Allow stopping early when blocked before full distance." />
                    <CheckBox x:Name="MoveAllowPartialCheckBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              VerticalAlignment="Center"
                              IsChecked="{Binding MoveAllowPartialMove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Content="Allow partial movement when blocked" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Jump Over Path" ToolTip="When enabled, intermediate path blockers may be jumped over, but destination conflicts still block." />
                    <CheckBox x:Name="MoveAllowJumpOverCheckBox"
                              Grid.Row="5"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              VerticalAlignment="Center"
                              IsChecked="{Binding MoveAllowJumpOver, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Content="Allow jump over intermediate blockers" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Travel Visual Mode" ToolTip="Choose whether hosts render multi-leg movement leg-by-leg or as one direct move." />
                    <ComboBox x:Name="MoveTravelVisualizationModeComboBox"
                              Grid.Row="6"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              SelectedItem="{Binding MoveTravelVisualizationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid x:Name="MoveRoomObjectByPointsEditorPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Margin="0,0,0,10"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Text="Uses ordered point tuples from command input. Runtime resolves path legs and movement legality from those points." />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Target Intent" ToolTip="Runtime target resolution behavior for point-based movement." />
                    <ComboBox x:Name="MoveByPointsTargetResolutionIntentComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              IsEditable="False"
                              ToolTip="Choose whether point movement resolves from primary selection, object at first point, or player." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Transition Hint" ToolTip="Host-side visual speed/style hint for movement presentation." />
                    <ComboBox x:Name="MoveByPointsVisualTransitionHintComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              ToolTip="Visual hint for point-based movement presentation." />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Partial Movement" ToolTip="Allow stopping early when blocked before full point sequence completion." />
                    <CheckBox x:Name="MoveByPointsAllowPartialCheckBox"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              VerticalAlignment="Center"
                              Content="Allow partial movement when blocked" />

                    <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Jump Over Path" ToolTip="When enabled, intermediate blockers may be jumped over, but destination conflicts still block." />
