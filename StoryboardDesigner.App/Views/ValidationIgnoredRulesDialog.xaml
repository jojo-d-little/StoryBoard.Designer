<Window x:Class="StoryboardDesigner.App.Views.ValidationIgnoredRulesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Ignored Validation Rules"
        Height="620"
        Width="760"
        MinHeight="520"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#111827" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,4"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   Text="Inherited ignored rules (read only)" />

        <ListBox x:Name="InheritedRulesListBox"
                 Grid.Row="2"
                 MinHeight="90"
                 BorderBrush="#D1D5DB"
                 BorderThickness="1"
                 Background="#F9FAFB" />

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,4"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   Text="Known validation rules" />

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="KnownFilterTextBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     Margin="0,0,8,8"
                     VerticalAlignment="Center"
                     TextChanged="KnownFilterTextBox_OnTextChanged" />
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Padding="10,2"
                    Content="Add Selected"
                    Click="AddSelectedKnownRule_OnClick" />

            <ListBox x:Name="KnownRulesListBox"
                     Grid.Row="1"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     BorderBrush="#D1D5DB"
                     BorderThickness="1"
                     Background="#F9FAFB"
                     MouseDoubleClick="KnownRulesListBox_OnMouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock Grid.Row="5"
                   Margin="0,10,0,4"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   Text="Ignored at this scope" />

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,2" Content="Add" Click="AddRule_OnClick" />
                <TextBox x:Name="RuleInputTextBox" VerticalAlignment="Center" />
            </DockPanel>

            <ListBox x:Name="IgnoredRulesListBox" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <Button DockPanel.Dock="Right"
                                    Width="28"
                                    Height="24"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    FontSize="14"
                                    Content="-"
                                    Click="RemoveRule_OnClick" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
