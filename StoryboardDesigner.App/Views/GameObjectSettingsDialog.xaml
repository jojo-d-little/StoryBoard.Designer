<Window x:Class="StoryboardDesigner.App.Views.GameObjectSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Game Object Settings"
        Height="980"
        Width="780"
        MinHeight="900"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,8">
            <Border x:Name="LinkedEditNoticeBorder"
                    Margin="0,0,0,6"
                    Padding="6,4"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#FFFBEB"
                    Visibility="Collapsed">
                <TextBlock x:Name="LinkedEditNoticeTextBlock"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#92400E"
                           FontSize="11" />
            </Border>

            <Border x:Name="LinkedBaseObjectNameBorder"
                    Padding="6,4"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#F9FAFB"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="#374151"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="Base Object Name" />
                    <TextBox x:Name="LinkedBaseObjectNameTextBox"
                             Grid.Column="1"
                             Margin="8,0,0,0"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#111827"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Name" />
        <TextBox x:Name="ObjectNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />

           <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Top" Text="Name in Game" />
           <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
               <TextBox x:Name="ObjectNameInGameTextBox" ToolTip="Optional player-facing alias used in command parsing. Leave blank to use Name." />
               <TextBlock Margin="0,6,0,2" Foreground="#4B5563" FontSize="11" Text="Synonyms (optional, comma-separated)" />
               <TextBox x:Name="ObjectNameSynonymsTextBox" ToolTip="Additional object lookup tokens separated by commas. Example: blade, knife" />
           </StackPanel>

           <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Top" Text="Producer Notes" />
        <TextBox x:Name="ObjectProducerNotesTextBox"
               Grid.Row="3"
             Grid.Column="1"
             Margin="0,0,0,12"
             MinHeight="56"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             TextWrapping="Wrap" />

           <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Top" Text="Features" />
           <Border Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" Padding="8" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Background="#F9FAFB">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Foreground="#374151" Text="Feature" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="#374151" Text="Game Property Name" />
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="#374151" Text="Default Value" />

                <CheckBox x:Name="InventoriableCheckBox" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Content="Inventoriable" ToolTip="Makes this object carryable by the player." />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="inventoryPoints" ToolTip="inventoryPoints is how many inventory points this object uses when carried." />
                <TextBox x:Name="InventoryPointsTextBox"
                         Grid.Row="1"
                         Grid.Column="2"
                         Margin="10,8,0,0"
                         VerticalContentAlignment="Center"
                         Text="1"
                         IsEnabled="{Binding IsChecked, ElementName=InventoriableCheckBox}"
                         PreviewTextInput="InventoryPointsTextBox_OnPreviewTextInput"
                         DataObject.Pasting="InventoryPointsTextBox_OnPasting"
                         ToolTip="Inventory cost of this object. Numeric only, minimum 1." />

                <CheckBox x:Name="ContainerCheckBox"
                          Grid.Row="2"
                          Grid.Column="0"
                          Margin="0,8,0,0"
                          VerticalAlignment="Center"
                          Content="Container"
                          ToolTip="Makes this object a container that can hold other items."
                          Checked="ContainerCheckBox_OnChanged"
                          Unchecked="ContainerCheckBox_OnChanged" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="containerPoints" ToolTip="containerPoints is the container capacity measured in inventory points." />
                <TextBox x:Name="ContainerPointsTextBox"
                         Grid.Row="2"
                         Grid.Column="2"
                         Margin="10,8,0,0"
                         VerticalContentAlignment="Center"
                         Text="1"
                         IsEnabled="{Binding IsChecked, ElementName=ContainerCheckBox}"
                         PreviewTextInput="InventoryPointsTextBox_OnPreviewTextInput"
                         DataObject.Pasting="InventoryPointsTextBox_OnPasting"
                         ToolTip="Maximum total inventory points this container can hold. Numeric only, minimum 1." />

                <CheckBox x:Name="CapacityPointShareDividerCheckBox"
                          Grid.Row="3"
                          Grid.Column="0"
                          Margin="0,8,0,0"
                          VerticalAlignment="Center"
                          Content="Capacity Point Share Divider"
                          ToolTip="Optional: when enabled, contained load passed up to parent is divided by this value. 1=full load, 2=half, 4=quarter."
                          Checked="CapacityPointShareDividerCheckBox_OnChanged"
                          Unchecked="CapacityPointShareDividerCheckBox_OnChanged" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Margin="10,8,0,0"
                           VerticalAlignment="Center"
                           Foreground="#111827"
                           Text="capacityPointShareDivider"
                           ToolTip="Divides the contained load this container passes to its parent. 1=full, 2=half, 4=quarter." />
                <TextBox x:Name="CapacityPointShareDividerTextBox"
                         Grid.Row="3"
                         Grid.Column="2"
                         Margin="10,8,0,0"
                         VerticalContentAlignment="Center"
                         Text="1"
                         IsEnabled="False"
                         PreviewTextInput="InventoryPointsTextBox_OnPreviewTextInput"
                         DataObject.Pasting="InventoryPointsTextBox_OnPasting"
                         ToolTip="Divider for contained load passed to parent. Numeric only, minimum 1." />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="26,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="#4B5563"
                           FontSize="11"
                           Text="Formula: effectiveLoadToParent = ownInventoryPoints + ceil(containedEffectiveLoad / capacityPointShareDivider). Example: divider 1 = full, 2 = half, 4 = quarter."
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, ElementName=ContainerCheckBox}" Value="True" />
                                        <Condition Binding="{Binding IsChecked, ElementName=CapacityPointShareDividerCheckBox}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <CheckBox x:Name="OpenableCheckBox" Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Content="Openable" ToolTip="Allows this object to be opened and closed." />
                <TextBlock Grid.Row="5" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="isOpen" ToolTip="isOpen stores whether the object starts open or closed." />
                <ComboBox x:Name="OpenDefaultValueComboBox" Grid.Row="5" Grid.Column="2" Margin="10,8,0,0" SelectedIndex="0" IsEnabled="{Binding IsChecked, ElementName=OpenableCheckBox}" ToolTip="Starting open state for this object.">
                    <ComboBoxItem Content="false" />
                    <ComboBoxItem Content="true" />
                </ComboBox>

                <CheckBox x:Name="LockableCheckBox" Grid.Row="6" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Content="Lockable" ToolTip="Allows this object to be locked and unlocked." Checked="LockableCheckBox_OnChanged" Unchecked="LockableCheckBox_OnChanged" />
                <TextBlock Grid.Row="6" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="isLocked" ToolTip="isLocked stores whether the object starts locked." />
                <ComboBox x:Name="LockedDefaultValueComboBox" Grid.Row="6" Grid.Column="2" Margin="10,8,0,0" SelectedIndex="0" IsEnabled="{Binding IsChecked, ElementName=LockableCheckBox}" ToolTip="Starting locked state for this object.">
                    <ComboBoxItem Content="false" />
                    <ComboBoxItem Content="true" />
                </ComboBox>

                <CheckBox x:Name="ActivatableCheckBox" Grid.Row="7" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Content="Activatable" ToolTip="Allow this object to be activated and deactivated, meaning it can be removed from the game state or added back to the game state. When inactive, it is treated as if it is not in the game." />
                <TextBlock Grid.Row="7" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="isActive" ToolTip="isActive stores whether the object starts in the active game state." />
                <ComboBox x:Name="ActiveDefaultValueComboBox" Grid.Row="7" Grid.Column="2" Margin="10,8,0,0" SelectedIndex="0" IsEnabled="{Binding IsChecked, ElementName=ActivatableCheckBox}" ToolTip="Starting active state for this object. If false, the object starts out of the game state.">
                    <ComboBoxItem Content="false" />
                    <ComboBoxItem Content="true" />
                </ComboBox>

                <CheckBox x:Name="HidableCheckBox" Grid.Row="8" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Content="Hidable" ToolTip="Allows this object to start hidden and later be revealed." />
                <TextBlock Grid.Row="8" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="isHidden" ToolTip="isHidden stores whether the object starts hidden." />
                <ComboBox x:Name="HiddenDefaultValueComboBox" Grid.Row="8" Grid.Column="2" Margin="10,8,0,0" SelectedIndex="0" IsEnabled="{Binding IsChecked, ElementName=HidableCheckBox}" ToolTip="Starting hidden state for this object.">
                    <ComboBoxItem Content="false" />
                    <ComboBoxItem Content="true" />
                </ComboBox>

                <CheckBox x:Name="MovableCheckBox" Grid.Row="9" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Content="Movable" ToolTip="Enables movement interactions and movement-related state for this object." Checked="MovableCheckBox_OnChanged" Unchecked="MovableCheckBox_OnChanged" />
                <TextBlock Grid.Row="9" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="isMovable" ToolTip="isMovable stores whether this object can be moved at runtime." />
                <ComboBox x:Name="MovableDefaultValueComboBox" Grid.Row="9" Grid.Column="2" Margin="10,8,0,0" SelectedIndex="1" IsEnabled="{Binding IsChecked, ElementName=MovableCheckBox}" ToolTip="Starting movable state for this object." SelectionChanged="MovableDefaultValueComboBox_OnSelectionChanged">
                    <ComboBoxItem Content="false" />
                    <ComboBoxItem Content="true" />
                </ComboBox>

                <CheckBox x:Name="QuantifiableCheckBox" Grid.Row="10" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Content="Quantifiable" ToolTip="Treat this object as a stackable quantity in gameplay." />
                <TextBlock Grid.Row="10" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="isQuantifiable" ToolTip="isQuantifiable marks this object as quantity-based." />
                <TextBox x:Name="QuantityTextBox"
                         Grid.Row="10"
                         Grid.Column="2"
                         Margin="10,8,0,0"
                         VerticalContentAlignment="Center"
                         Text="1"
                         IsEnabled="{Binding IsChecked, ElementName=QuantifiableCheckBox}"
                         PreviewTextInput="InventoryPointsTextBox_OnPreviewTextInput"
                         DataObject.Pasting="InventoryPointsTextBox_OnPasting"
                         ToolTip="Initial quantity for this object. Numeric only, minimum 1." />

                <TextBlock Grid.Row="11" Grid.Column="1" Margin="10,8,0,0" VerticalAlignment="Center" Foreground="#111827" Text="quantifiablePlacementDistributionMode" ToolTip="How quantity is represented in room placement." />
                <ComboBox x:Name="QuantifiableDistributionModeComboBox"
                          Grid.Row="11"
                          Grid.Column="2"
                          Margin="10,8,0,0"
                          SelectedIndex="0"
                          IsEnabled="{Binding IsChecked, ElementName=QuantifiableCheckBox}"
                          ToolTip="GroupedStack stores quantity on one object. IndividualInstances fans out per unit.">
                    <ComboBoxItem Content="GroupedStack" />
                    <ComboBoxItem Content="IndividualInstances" />
                </ComboBox>

                <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Top" Foreground="#111827" Text="Appearance" />
                <Border Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,10,0,0" Padding="8" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="#FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Button x:Name="ManageImageVariantsButton"
                                    Width="168"
                                    Height="28"
                                    Content="Manage Appearance..."
                                    ToolTip="Open appearance editor for variants, footprint, orientation, heading, and visual scale guidance."
                                    Click="ManageImageVariantsButton_OnClick" />

                            <Button x:Name="ManageMovementRestrictionsButton"
                                    Width="168"
                                    Height="28"
                                    Margin="10,0,0,0"
                                    Content="Movement Rules..."
                                    ToolTip="Edit per-direction movement restrictions for first/later and open/stacked landings, plus optional multi-leg total distance cap."
                                    Click="ManageMovementRestrictionsButton_OnClick" />
                        </StackPanel>

                        <TextBlock x:Name="ImageVariantValidationHintTextBlock"
                                   Grid.Row="1"
                                   Margin="0,8,0,0"
                                   Foreground="#B45309"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Top" Text="Description" />
        <TextBox x:Name="ObjectDescriptionTextBox"
             Grid.Row="5"
                 Grid.Column="1"
                 Grid.RowSpan="2"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" />

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Top" Text="Composite" />
        <Border Grid.Row="6" Grid.Column="1" Margin="0,0,0,12" Padding="8" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Background="#F9FAFB">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="CompositableCheckBox"
                          Grid.Row="0"
                          Grid.Column="0"
                          Margin="0,0,8,8"
                          VerticalAlignment="Center"
                          Content="Compositable"
                          Checked="CompositableCheckBox_OnChanged"
                          Unchecked="CompositableCheckBox_OnChanged"
                          ToolTip="Enable composite recipe behavior for this object." />

                <Button x:Name="ManageCompositeButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Padding="12,2"
                        Content="Manage..."
                        IsEnabled="{Binding IsChecked, ElementName=CompositableCheckBox}"
                        Click="ManageCompositeButton_OnClick" />

                <TextBlock x:Name="CompositeSummaryTextBlock"
                           Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           TextWrapping="Wrap"
                           Foreground="#4B5563"
                           FontSize="11"
                           Text="Composite settings are disabled." />
            </Grid>
        </Border>

        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Top" Text="Lock Rules" />
        <Border Grid.Row="7" Grid.Column="1" Margin="0,0,0,12" Padding="8" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Background="#F9FAFB">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Foreground="#4B5563"
                           FontSize="11"
                           Text="Author key requirements used by UnlockObject and LockObject runtime actions." />

                <Button x:Name="ManageLockRequirementsButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Padding="12,2"
                        Content="Manage..."
                        IsEnabled="{Binding IsChecked, ElementName=LockableCheckBox}"
                        Click="ManageLockRequirementsButton_OnClick" />

                <TextBlock x:Name="LockRequirementsSummaryTextBlock"
                           Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           TextWrapping="Wrap"
                           Foreground="#4B5563"
                           FontSize="11"
                           Text="Lock requirements are disabled." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
