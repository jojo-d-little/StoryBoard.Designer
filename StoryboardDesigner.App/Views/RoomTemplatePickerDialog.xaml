<Window x:Class="StoryboardDesigner.App.Views.RoomTemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Room Template"
        Height="420"
        Width="520"
        MinHeight="360"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,10"
                   Foreground="#4B5563"
                   TextWrapping="Wrap"
                   Text="Choose a room template to bootstrap the new room. Blank Room creates an empty room without template defaults." />

        <ListBox x:Name="TemplatesListBox"
                 Grid.Row="1"
                 DisplayMemberPath="Label"
                 MouseDoubleClick="TemplatesListBox_OnMouseDoubleClick" />

        <StackPanel Grid.Row="2"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,8,0" Content="Select" Click="Select_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
