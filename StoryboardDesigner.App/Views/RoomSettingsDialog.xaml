<Window x:Class="StoryboardDesigner.App.Views.RoomSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Settings"
        Height="650"
        Width="560"
        MinHeight="600"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Name" />
        <TextBox x:Name="RoomNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Name In Game" />
        <TextBox x:Name="RoomNameInGameTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 ToolTip="Optional player-facing room label. Leave blank to use Name." />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Orientation Preset" />
        <ComboBox x:Name="OrientationPresetComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Value"
                  SelectionChanged="OrientationPresetComboBox_OnSelectionChanged"
                  ToolTip="Choose landscape or portrait presets, or keep custom room dimensions." />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Room Width" />
        <TextBox x:Name="RoomCanvasWidthTextBox"
                 Grid.Row="3"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 TextChanged="RoomCanvasTextBox_OnTextChanged"
                 ToolTip="Room display width in pixels." />

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Room Height" />
        <TextBox x:Name="RoomCanvasHeightTextBox"
                 Grid.Row="4"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 TextChanged="RoomCanvasTextBox_OnTextChanged"
                 ToolTip="Room display height in pixels." />

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Effective Grid" />
        <TextBlock x:Name="EffectiveGridSummaryTextBlock"
                   Grid.Row="5"
                   Grid.Column="1"
                   Margin="0,0,0,12"
                   VerticalAlignment="Center"
                   Foreground="#4B5563"
                   Text="-" />

        <CheckBox x:Name="AmbientLightingEnabledCheckBox"
                  Grid.Row="6"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,10"
                  Content="Override project ambient lighting for this room"
                  ToolTip="Enable room-specific overrides. Each entered value overrides the project default; leave a field blank to inherit that value from project settings. Uncheck to remove the room override."
                  Checked="AmbientLightingEnabledCheckBox_OnChanged"
                  Unchecked="AmbientLightingEnabledCheckBox_OnChanged" />

        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Ambient intensity" ToolTip="Room-wide baseline light level from 0 to 1. Zero is fully dark; 1 is full ambient contribution. Leave blank to inherit the project default." />
        <Grid Grid.Row="7" Grid.Column="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AmbientIntensityTextBox" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" LostFocus="AmbientIntensityTextBox_OnLostFocus" ToolTip="Enter a value from 0 to 1, or leave blank to inherit the project default." />
            <Slider x:Name="AmbientIntensitySlider" Grid.Column="1" Margin="0,0,8,0" Minimum="0" Maximum="1" TickFrequency="0.1" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="False" ValueChanged="AmbientIntensitySlider_OnValueChanged" ToolTip="Common range: 0 to 1." />
            <RepeatButton Grid.Column="2" Margin="0,0,4,0" Content="−" Click="AmbientIntensityDecrement_OnClick" ToolTip="Decrease by 0.05" />
            <RepeatButton Grid.Column="3" Content="+" Click="AmbientIntensityIncrement_OnClick" ToolTip="Increase by 0.05" />
        </Grid>

        <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Ambient color" ToolTip="Room-wide ambient tint. Leave blank to inherit the project default color." />
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border x:Name="AmbientColorPreview" Width="32" Height="24" Margin="0,0,8,0" BorderBrush="#6B7280" BorderThickness="1" />
            <TextBox x:Name="AmbientColorHexTextBox" Width="90" Margin="0,0,8,0" IsReadOnly="True" VerticalContentAlignment="Center" />
            <Button Width="72" Margin="0,0,6,0" Content="Pick..." Click="PickAmbientColor_OnClick" />
            <Button Width="60" Content="Clear" Click="ClearAmbientColor_OnClick" />
        </StackPanel>

        <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Top" Text="Producer Notes" />
        <TextBox x:Name="ProducerNotesTextBox"
                 Grid.Row="9"
                 Grid.Column="1"
                 Grid.RowSpan="1"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" />

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
