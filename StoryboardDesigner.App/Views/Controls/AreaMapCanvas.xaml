<UserControl x:Class="StoryboardDesigner.App.Views.Controls.AreaMapCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StoryboardDesigner.App.Views.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Background="#FBFBFC">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseLeftButtonDown="AreaMapScrollViewer_OnPreviewMouseLeftButtonDown"
                          PreviewMouseMove="AreaMapScrollViewer_OnPreviewMouseMove"
                          PreviewMouseLeftButtonUp="AreaMapScrollViewer_OnPreviewMouseLeftButtonUp">
                <Canvas Width="{Binding CanvasWidth}"
                        Height="{Binding CanvasHeight}"
                        AutomationProperties.AutomationId="MainWindow.AreaDesigner.MapCanvas"
                        AllowDrop="True"
                        Drop="NavigationCanvas_OnDrop">
                    <Canvas.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </Canvas.LayoutTransform>
                    <Canvas.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,180,140" ViewportUnits="Absolute" Stretch="None">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#F3F4F6">
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#E5E7EB" Thickness="1" />
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,180,140" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Canvas.Background>

                    <ItemsControl ItemsSource="{Binding NavigationArrows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="18"
                                        Height="18"
                                        Content=">"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Padding="0"
                                        BorderThickness="1"
                                        ToolTip="{Binding ValidationToolTip}"
                                        MouseDoubleClick="NavigationArrow_OnMouseDoubleClick"
                                        PreviewMouseRightButtonDown="NavigationArrow_OnPreviewMouseRightButtonDown">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#9CA3AF" />
                                            <Setter Property="Foreground" Value="#111827" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                    <Setter Property="BorderBrush" Value="#B91C1C" />
                                                    <Setter Property="Foreground" Value="#7F1D1D" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                    <Setter Property="BorderBrush" Value="#B45309" />
                                                    <Setter Property="Foreground" Value="#78350F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.RenderTransform>
                                        <RotateTransform Angle="{Binding Angle}" />
                                    </Button.RenderTransform>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Delete"
                                                      Click="NavigationArrowDelete_OnClick" />
                                            <MenuItem Header="Change Destination" Click="NavigationArrowChangeDestination_OnClick" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding VisibleRoomPlacements}"
                                  AutomationProperties.AutomationId="MainWindow.AreaDesigner.RoomPlacements">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:AreaRoomPlacementCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
