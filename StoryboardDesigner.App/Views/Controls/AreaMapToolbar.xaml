<UserControl x:Class="StoryboardDesigner.App.Views.Controls.AreaMapToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="48"
             d:DesignWidth="900">
    <Border Padding="6" Margin="0,0,0,8" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="-" Width="28" Height="24"
                    Command="{Binding DataContext.ZoomOutSelectedAreaMapCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Margin="8,0,8,0" VerticalAlignment="Center" Text="{Binding ZoomPercentText}" />
            <Button Content="+" Width="28" Height="24"
                    Command="{Binding DataContext.ZoomInSelectedAreaMapCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Margin="10,0,0,0" Content="100%" Padding="10,2"
                    Command="{Binding DataContext.ResetSelectedAreaMapZoomCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Margin="8,0,0,0" Content="Fit" Padding="10,2" Click="AreaMapFit_OnClick" />
            <Separator Margin="10,0,10,0" Width="1" Height="20" />
            <Button Content="Grow Grid" Padding="10,2"
                    Command="{Binding DataContext.GrowSelectedAreaMapGridCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#6B7280"
                       Text="{Binding GridColumns, StringFormat=Cols: {0}}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#6B7280"
                       Text="{Binding GridRows, StringFormat=Rows: {0}}" />
            <Separator Margin="10,0,10,0" Width="1" Height="20" />
            <Button Content="Floor -" Padding="10,2" Click="AreaMapFloorDown_OnClick" />
            <TextBlock Margin="8,0,8,0" VerticalAlignment="Center" Foreground="#4B5563"
                       Text="{Binding SelectedFloorText}" />
            <Button Content="Floor +" Padding="10,2" Click="AreaMapFloorUp_OnClick" />
            <Separator Margin="10,0,10,0" Width="1" Height="20" />
            <Button Content="Add Traversal" Padding="10,2"
                    Command="{Binding DataContext.AddNavigationLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#4B5563"
                       Text="{Binding SelectedTraversalSourceText}" />
        </StackPanel>
    </Border>
</UserControl>
