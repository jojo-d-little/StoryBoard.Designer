<UserControl x:Class="StoryboardDesigner.App.Views.Controls.ProjectHierarchyPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StoryboardDesigner.App.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="280"
             AutomationProperties.AutomationId="MainWindow.HierarchyPane">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ValidationBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Text" Value="{Binding ValidationBadgeCompactText}" />
            <Setter Property="ToolTip" Value="{x:Null}" />
            <Setter Property="Visibility" Value="{Binding HasValidationBadge, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Setter Property="Foreground" Value="#64748B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShouldShowValidationSummaryToolTip}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding ValidationSummaryToolTip}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasValidationErrorsOnNode}" Value="True">
                    <Setter Property="Foreground" Value="#B91C1C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasValidationWarningsOnNode}" Value="True">
                    <Setter Property="Foreground" Value="#B45309" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasValidationErrorsInDescendants}" Value="True">
                    <Setter Property="Foreground" Value="#DC2626" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasValidationWarningsInDescendants}" Value="True">
                    <Setter Property="Foreground" Value="#D97706" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsValidationStatusStale}" Value="True">
                    <Setter Property="Foreground" Value="#64748B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:ProjectRootNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Canvas Width="14" Height="14" Margin="0,0,6,0" Background="Transparent">
                    <Ellipse Width="12" Height="12" Stroke="#0F766E" StrokeThickness="1.2" Fill="#CCFBF1" Canvas.Left="1" Canvas.Top="1" />
                    <Line X1="2" Y1="7" X2="12" Y2="7" Stroke="#0F766E" StrokeThickness="0.8" />
                    <Line X1="7" Y1="2" X2="7" Y2="12" Stroke="#0F766E" StrokeThickness="0.8" />
                </Canvas>
                <TextBlock VerticalAlignment="Center" Text="{Binding EditableName}" />
                <TextBlock Style="{StaticResource ValidationBadgeTextStyle}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:PlanetNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Canvas Width="14" Height="14" Margin="0,0,6,0" Background="Transparent">
                    <Ellipse Width="12" Height="12" Stroke="#2563EB" StrokeThickness="1.2" Fill="#DBEAFE" Canvas.Left="1" Canvas.Top="1" />
                    <Ellipse Width="6" Height="12" Stroke="#2563EB" StrokeThickness="0.8" Fill="Transparent" Canvas.Left="4" Canvas.Top="1" />
                    <Line X1="1" Y1="7" X2="13" Y2="7" Stroke="#2563EB" StrokeThickness="0.8" />
                    <Ellipse Width="4.2" Height="4.2"
                             Fill="#10B981"
                             Stroke="#065F46"
                             StrokeThickness="0.8"
                             Canvas.Left="9.6"
                             Canvas.Top="-0.2"
                             ToolTip="Starting planet"
                             Visibility="{Binding IsStartingPlanet, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Canvas>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Foreground}"
                           Text="{Binding EditableName}" />
                <TextBlock Style="{StaticResource ValidationBadgeTextStyle}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:GlobalObjectsNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Canvas Width="14" Height="14" Margin="0,0,6,0" Background="Transparent">
                    <Rectangle Width="10" Height="8" RadiusX="1" RadiusY="1" Stroke="#6B7280" Fill="#F3F4F6" StrokeThickness="1" Canvas.Left="2" Canvas.Top="3" />
                    <Rectangle Width="10" Height="2" Fill="#D1D5DB" Canvas.Left="2" Canvas.Top="3" />
                </Canvas>
                <TextBlock VerticalAlignment="Center" Text="{Binding EditableName}" />
                <TextBlock Style="{StaticResource ValidationBadgeTextStyle}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:ObjectTemplatesNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Canvas Width="14" Height="14" Margin="0,0,6,0" Background="Transparent">
