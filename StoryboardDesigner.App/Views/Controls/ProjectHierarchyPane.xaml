                    <Rectangle Width="3.2" Height="3.2" RadiusX="0.6" RadiusY="0.6" Fill="#E5E7EB" Stroke="#4B5563" StrokeThickness="0.8" Canvas.Left="9" Canvas.Top="2" />
                    <Rectangle Width="3.2" Height="3.2" RadiusX="0.6" RadiusY="0.6" Fill="#E5E7EB" Stroke="#4B5563" StrokeThickness="0.8" Canvas.Left="5" Canvas.Top="9" />
                    <Line X1="4.2" Y1="3.6" X2="9" Y2="3.6" Stroke="#4B5563" StrokeThickness="0.8" />
                    <Line X1="2.6" Y1="5.2" X2="6.2" Y2="9" Stroke="#4B5563" StrokeThickness="0.8" />
