    <Grid Margin="12,12,6,12">
        <Border Padding="12" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10">
                    Project Hierarchy
                </TextBlock>
                <TreeView x:Name="HierarchyTree"
                          AutomationProperties.AutomationId="MainWindow.HierarchyTree"
                          Background="#F9FAFB"
                          BorderBrush="#E5E7EB"
                          BorderThickness="1"
                          Foreground="#111827"
                          ItemsSource="{Binding HierarchyRoots}"
                          SelectedItemChanged="HierarchyTree_OnSelectedItemChanged"
                          MouseDoubleClick="HierarchyTree_OnMouseDoubleClick"
                          PreviewMouseLeftButtonDown="HierarchyTree_OnPreviewMouseLeftButtonDown"
                          PreviewKeyDown="HierarchyTree_OnPreviewKeyDown"
                          PreviewMouseMove="HierarchyTree_OnPreviewMouseMove"
                          PreviewMouseRightButtonDown="HierarchyTree_OnPreviewMouseRightButtonDown"
                          ContextMenuOpening="HierarchyTree_OnContextMenuOpening">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="FontStyle" Value="Normal" />
                            <Setter Property="ToolTip" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShouldShowValidationSummaryToolTip}" Value="True">
                                    <Setter Property="ToolTip" Value="{Binding ValidationSummaryToolTip}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasValidationErrorsOnNode}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasValidationWarningsOnNode}" Value="True">
                                    <Setter Property="Foreground" Value="#B45309" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasValidationErrorsInDescendants}" Value="True">
                                    <Setter Property="Foreground" Value="#DC2626" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasValidationWarningsInDescendants}" Value="True">
                                    <Setter Property="Foreground" Value="#D97706" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsValidationStatusStale}" Value="True">
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111827" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111827" />
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
