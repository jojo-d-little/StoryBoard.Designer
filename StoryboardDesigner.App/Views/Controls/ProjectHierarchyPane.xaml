                    <Rectangle Width="8" Height="1.6" Fill="#1E40AF" Canvas.Left="3" Canvas.Top="6" />
                    <Rectangle Width="8" Height="1.6" Fill="#1E40AF" Canvas.Left="3" Canvas.Top="8.4" />
                </Canvas>
                <TextBlock VerticalAlignment="Center" Text="{Binding EditableName}" />
