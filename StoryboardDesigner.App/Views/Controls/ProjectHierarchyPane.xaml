                    <Line X1="7" Y1="6" X2="7" Y2="2" Stroke="#7C3AED" StrokeThickness="1" />
                </Canvas>
                <TextBlock VerticalAlignment="Center" Text="{Binding EditableName}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:TraversalLegNodeViewModel}" ItemsSource="{Binding Children}">
            <DockPanel LastChildFill="False" ToolTip="{Binding DestinationToolTip}">
