                    <Rectangle Width="2" Height="3.2" Fill="#065F46" Canvas.Left="4" Canvas.Top="7" />
                    <Rectangle Width="2" Height="3.2" Fill="#065F46" Canvas.Left="8" Canvas.Top="7" />
