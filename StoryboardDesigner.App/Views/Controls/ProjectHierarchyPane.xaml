                </Canvas>
                <TextBlock VerticalAlignment="Center" Text="{Binding EditableName}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:RoomTraversalLegsNodeViewModel}" ItemsSource="{Binding Children}">
