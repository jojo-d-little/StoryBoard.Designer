<Window x:Class="StoryboardDesigner.App.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color"
        Height="500"
        Width="720"
        MinHeight="500"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Foreground="#374151"
                   Text="Choose from the color field, adjust the hue, or enter exact RGB/hex values."
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ColorField"
                  Grid.Column="0"
                  MinHeight="260"
                  Background="White"
                  ClipToBounds="True"
                  MouseLeftButtonDown="ColorField_OnMouseLeftButtonDown"
                  MouseLeftButtonUp="ColorField_OnMouseLeftButtonUp"
                  MouseMove="ColorField_OnMouseMove">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="ColorFieldThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2" />
                </Canvas>
            </Grid>

            <Grid x:Name="HueField"
                  Grid.Column="1"
                  ClipToBounds="True"
                  MouseLeftButtonDown="HueField_OnMouseLeftButtonDown"
                  MouseLeftButtonUp="HueField_OnMouseLeftButtonUp"
                  MouseMove="HueField_OnMouseMove">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="HueTrack" Grid.Row="1" ClipToBounds="True">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFF0000" Offset="0" />
                                <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                <GradientStop Color="#FFFF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas x:Name="HueThumbCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="HueThumb" Width="32" Height="6" Fill="Transparent" Stroke="White" StrokeThickness="2" />
                    </Canvas>
                </Grid>
                <RepeatButton Grid.Row="0" Width="24" Height="20" HorizontalAlignment="Center" Margin="0,0,0,4" Content="▲" FontSize="9" Tag="-1" Click="HueNudge_OnClick" ToolTip="Nudge hue up by 1° (hold to repeat)." />
                <RepeatButton Grid.Row="2" Width="24" Height="20" HorizontalAlignment="Center" Margin="0,4,0,0" Content="▼" FontSize="9" Tag="1" Click="HueNudge_OnClick" ToolTip="Nudge hue down by 1° (hold to repeat)." />
            </Grid>

            <UniformGrid x:Name="HueSwatchPanel" Grid.Column="2" Rows="4" Columns="3" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FFFF0000" BorderBrush="#6B7280" BorderThickness="1" Tag="0" Click="HueSwatch_OnClick" ToolTip="Red hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FFFF8000" BorderBrush="#6B7280" BorderThickness="1" Tag="30" Click="HueSwatch_OnClick" ToolTip="Orange hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FFFFFF00" BorderBrush="#6B7280" BorderThickness="1" Tag="60" Click="HueSwatch_OnClick" ToolTip="Yellow hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FF80FF00" BorderBrush="#6B7280" BorderThickness="1" Tag="90" Click="HueSwatch_OnClick" ToolTip="Chartreuse hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FF00FF00" BorderBrush="#6B7280" BorderThickness="1" Tag="120" Click="HueSwatch_OnClick" ToolTip="Green hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FF00FF80" BorderBrush="#6B7280" BorderThickness="1" Tag="150" Click="HueSwatch_OnClick" ToolTip="Spring green hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FF00FFFF" BorderBrush="#6B7280" BorderThickness="1" Tag="180" Click="HueSwatch_OnClick" ToolTip="Cyan hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FF0080FF" BorderBrush="#6B7280" BorderThickness="1" Tag="210" Click="HueSwatch_OnClick" ToolTip="Azure hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FF0000FF" BorderBrush="#6B7280" BorderThickness="1" Tag="240" Click="HueSwatch_OnClick" ToolTip="Blue hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FF8000FF" BorderBrush="#6B7280" BorderThickness="1" Tag="270" Click="HueSwatch_OnClick" ToolTip="Violet hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FFFF00FF" BorderBrush="#6B7280" BorderThickness="1" Tag="300" Click="HueSwatch_OnClick" ToolTip="Magenta hue" />
                <Button Width="20" Height="20" Margin="2" Padding="0" Background="#FFFF0080" BorderBrush="#6B7280" BorderThickness="1" Tag="330" Click="HueSwatch_OnClick" ToolTip="Rose hue" />
            </UniformGrid>

            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Preview" />
                <Border x:Name="ColorPreview" Height="100" Margin="0,0,0,12" BorderBrush="#6B7280" BorderThickness="1" />
                <TextBlock Foreground="#374151" Text="The left-to-right axis changes saturation. The top-to-bottom axis changes brightness." TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="R" />
            <TextBox x:Name="RedTextBox" Grid.Column="1" Margin="0,0,16,0" VerticalContentAlignment="Center" LostFocus="ColorComponentTextBox_OnLostFocus" Tag="Red" />
            <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Text="G" />
            <TextBox x:Name="GreenTextBox" Grid.Column="3" Margin="0,0,16,0" VerticalContentAlignment="Center" LostFocus="ColorComponentTextBox_OnLostFocus" Tag="Green" />
            <TextBlock Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center" Text="B" />
            <TextBox x:Name="BlueTextBox" Grid.Column="5" VerticalContentAlignment="Center" LostFocus="ColorComponentTextBox_OnLostFocus" Tag="Blue" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Hex color" />
            <TextBox x:Name="HexTextBox" Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center" MaxLength="7" ToolTip="Format: #RRGGBB" />
            <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#6B7280" Text="Six-digit RGB color; alpha is not used." />
            <Button Grid.Column="3" Content="Apply Hex" Click="ApplyHex_OnClick" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,8,0" Content="Select" Click="Select_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
