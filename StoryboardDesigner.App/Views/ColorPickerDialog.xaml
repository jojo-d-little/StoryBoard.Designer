<Window x:Class="StoryboardDesigner.App.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color"
        Height="360"
        Width="520"
        MinHeight="360"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="70" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12" Foreground="#374151" Text="Adjust the red, green, and blue channels or enter an exact six-digit color." TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="R" />
        <Slider x:Name="RedSlider" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10" Minimum="0" Maximum="255" TickFrequency="16" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="False" Tag="Red" ValueChanged="ColorSlider_OnValueChanged" />
        <TextBox x:Name="RedTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" LostFocus="ColorComponentTextBox_OnLostFocus" Tag="Red" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="G" />
        <Slider x:Name="GreenSlider" Grid.Row="2" Grid.Column="1" Margin="0,0,8,10" Minimum="0" Maximum="255" TickFrequency="16" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="False" Tag="Green" ValueChanged="ColorSlider_OnValueChanged" />
        <TextBox x:Name="GreenTextBox" Grid.Row="2" Grid.Column="2" Margin="0,0,0,10" LostFocus="ColorComponentTextBox_OnLostFocus" Tag="Green" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="B" />
        <Slider x:Name="BlueSlider" Grid.Row="3" Grid.Column="1" Margin="0,0,8,10" Minimum="0" Maximum="255" TickFrequency="16" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="False" Tag="Blue" ValueChanged="ColorSlider_OnValueChanged" />
        <TextBox x:Name="BlueTextBox" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10" LostFocus="ColorComponentTextBox_OnLostFocus" Tag="Blue" />

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,6" VerticalAlignment="Center" Text="Hex color" />
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Border x:Name="ColorPreview" Width="150" Height="70" Margin="0,0,12,0" BorderBrush="#6B7280" BorderThickness="1" />
            <TextBox x:Name="HexTextBox" Width="110" Height="28" VerticalContentAlignment="Center" MaxLength="7" ToolTip="Format: #RRGGBB" />
            <Button Width="82" Height="28" Margin="8,0,0,0" Content="Apply Hex" Click="ApplyHex_OnClick" />
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Select" Click="Select_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
