<Window x:Class="StoryboardDesigner.App.Views.TimerDefinitionLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timer Definitions"
        Height="540"
        Width="1100"
        MinHeight="540"
        MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="#374151"
                   Text="Create and tune scope-owned timer definitions. Double-click an entry to edit details." />

        <DataGrid x:Name="EntriesDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  MouseDoubleClick="EntriesDataGrid_OnMouseDoubleClick"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timer Key" Width="180" Binding="{Binding TimerKey}" />
                <DataGridTextColumn Header="Delay (ms)" Width="95" Binding="{Binding ScheduleAfterMs}" />
                <DataGridTextColumn Header="Fire" Width="95" Binding="{Binding FireMode}" />
                <DataGridTextColumn Header="Repeat" Width="115" Binding="{Binding RepeatMode}" />
                <DataGridTextColumn Header="Target Action" Width="220" Binding="{Binding TargetActionRef}" />
                <DataGridTextColumn Header="Owner" Width="100" Binding="{Binding LifetimeOwnerType}" />
                <DataGridTextColumn Header="Conflict" Width="130" Binding="{Binding ConflictBehavior}" />
                <DataGridCheckBoxColumn Header="Enabled" Width="80" Binding="{Binding Enabled}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Margin="0,0,8,0" Content="Add Entry" Click="AddEntry_OnClick" />
            <Button Width="120" Margin="0,0,8,0" Content="Edit Entry" Click="EditEntry_OnClick" />
            <Button Width="120" Margin="0,0,18,0" Content="Remove Entry" Click="RemoveEntry_OnClick" />
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
