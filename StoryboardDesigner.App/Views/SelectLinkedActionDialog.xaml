<Window x:Class="StoryboardDesigner.App.Views.SelectLinkedActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Existing Action"
        Height="360"
        Width="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="ActionsListBox" DisplayMemberPath="Label" ToolTip="Choose an existing action to link into the current flow." />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="92" Margin="0,0,8,0" Content="Select" Click="Select_OnClick" />
            <Button Width="92" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
