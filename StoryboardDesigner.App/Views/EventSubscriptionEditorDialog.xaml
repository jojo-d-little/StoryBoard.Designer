<Window x:Class="StoryboardDesigner.App.Views.EventSubscriptionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Subscription"
        Height="700"
        Width="1100"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="#374151"
                   TextWrapping="Wrap"
                   Text="Edit one event subscription. This subscription owns its own action bindings and filter conditions." />

        <GroupBox Grid.Row="1" Header="Subscription" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6" Text="Event Key" />
                <ComboBox x:Name="EventKeyComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="0,0,0,6"
                          IsEditable="False"
                          SelectionChanged="EventKeyComboBox_OnSelectionChanged"
                          LostKeyboardFocus="EventKeyComboBox_OnLostKeyboardFocus" />

                <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,6" Text="Subscription Name" />
                <TextBox x:Name="SubscriptionNameTextBox"
                         Grid.Row="0"
                         Grid.Column="4"
                         VerticalAlignment="Center"
                         Margin="0,0,0,6"
                         TextChanged="SubscriptionNameTextBox_OnTextChanged" />

                <TextBlock Grid.Row="0" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,8,6" Text="Dispatch" />
                <ComboBox x:Name="DispatchComboBox" Grid.Row="0" Grid.Column="7" VerticalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6" Text="Lane" />
                <ComboBox x:Name="LaneComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="0,0,0,6"
                          IsEditable="False" />

                <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,6" Text="Source Match" />
                <ComboBox x:Name="SourceMatchModeComboBox"
                          Grid.Row="1"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          Margin="0,0,0,6"
                          IsEditable="False"
                          SelectionChanged="SourceMatchModeComboBox_OnSelectionChanged" />

                <TextBlock Grid.Row="1" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,8,6" Text="Source Scope Id" />
                <Grid Grid.Row="1" Grid.Column="7" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SourceScopeIdTextBox"
                             Grid.Column="0"
                             VerticalAlignment="Center"
                             ToolTip="Optional. Used when Source Match is ExplicitSourceId." />

                    <Button x:Name="ChooseSourceScopeButton"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Content="Choose..."
                            Click="ChooseSourceScope_OnClick" />

                    <Button x:Name="ClearSourceScopeButton"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Content="Clear"
                            Click="ClearSourceScope_OnClick" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,6" Text="Secondary Source Match" />
                <ComboBox x:Name="SecondarySourceMatchModeComboBox"
                          Grid.Row="2"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          Margin="0,0,0,6"
                          IsEditable="False"
                          SelectionChanged="SecondarySourceMatchModeComboBox_OnSelectionChanged" />

                <TextBlock Grid.Row="2" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,8,6" Text="Secondary Source Scope Id" />
                <Grid Grid.Row="2" Grid.Column="7" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SecondarySourceScopeIdTextBox"
                             Grid.Column="0"
                             VerticalAlignment="Center"
                             ToolTip="Optional. Used when Secondary Source Match is ExplicitSourceId." />

                    <Button x:Name="ChooseSecondarySourceScopeButton"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Content="Choose..."
                            Click="ChooseSecondarySourceScope_OnClick" />

                    <Button x:Name="ClearSecondarySourceScopeButton"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Content="Clear"
                            Click="ClearSecondarySourceScope_OnClick" />
                </Grid>

                <CheckBox x:Name="VisibleWhenContainedCheckBox"
                          Grid.Row="3"
                          Grid.Column="0"
                          Grid.ColumnSpan="4"
                          Margin="0,0,0,0"
                          VerticalAlignment="Center"
                          Content="Visible When Contained" />

                <CheckBox x:Name="IsEnabledCheckBox"
                          Grid.Row="3"
                          Grid.Column="4"
                          Grid.ColumnSpan="4"
                          Margin="0,0,0,0"
                          VerticalAlignment="Center"
                          Content="Enabled" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Action Bindings" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,8"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Text="On Missing defines failure policy. Stop On Failure halts later bindings when a binding fails." />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Width="130" Margin="0,0,8,0" Content="Add Binding" Click="AddBinding_OnClick" />
                    <Button Width="140" Margin="0,0,8,0" Content="Remove Binding" Click="RemoveBinding_OnClick" />
                </StackPanel>

                <DataGrid x:Name="BindingsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="BindingsDataGrid_OnSelectionChanged"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order" Width="70" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridCheckBoxColumn Header="Enabled" Width="70" Binding="{Binding IsEnabled}" />
                        <DataGridTemplateColumn Header="Action Name" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              StaysOpenOnEdit="True"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActionNameSuggestions}"
                                              Text="{Binding Target.ActionName, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              StaysOpenOnEdit="True"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActionNameSuggestions}"
                                              Text="{Binding Target.ActionName, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="On Missing" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Target.OnMissingAction}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              StaysOpenOnEdit="True"
                                              ToolTip="DiagnosticOnly: emit diagnostics and continue."
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OnMissingActionOptions}"
                                              Text="{Binding Target.OnMissingAction, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="Stop On Failure"
                                                Width="105"
                                                Binding="{Binding Target.StopChainOnFailure}"
                                                ElementStyle="{x:Null}"
                                                EditingElementStyle="{x:Null}" />
                        <DataGridTemplateColumn Header="Filter Match Mode" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="False"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=QuantityModes}"
                                              SelectedItem="{Binding Condition.QuantityEvaluationMode, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="False"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=QuantityModes}"
                                              SelectedItem="{Binding Condition.QuantityEvaluationMode, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Arguments" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Mappings..."
                                            Padding="8,2"
                                            Click="OpenInputMappings_OnClick" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Filter Conditions">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Width="120" Margin="0,0,8,0" Content="Add Filter" Click="AddFilter_OnClick" />
                    <Button Width="130" Margin="0,0,8,0" Content="Remove Filter" Click="RemoveFilter_OnClick" />
                    <Button Width="140" Margin="0,0,8,0" Content="Choose Variable..." Click="ChooseFilterVariable_OnClick" />
                </StackPanel>

                <DataGrid x:Name="FiltersDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Variable Name" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VariableName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              StaysOpenOnEdit="True"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FilterVariableSuggestions}"
                                              Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Operator" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="False"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ComparisonOperators}"
                                              SelectedItem="{Binding Operator, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="False"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ComparisonOperators}"
                                              SelectedItem="{Binding Operator, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Expected Value" Width="220" Binding="{Binding ExpectedValue, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
