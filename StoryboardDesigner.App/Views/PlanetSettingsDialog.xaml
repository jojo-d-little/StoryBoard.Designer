<Window x:Class="StoryboardDesigner.App.Views.PlanetSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planet Settings"
        Height="320"
        Width="500"
        MinHeight="320"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Name" />
        <TextBox x:Name="PlanetNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Starting Country" />
        <ComboBox x:Name="StartingCountryComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" IsEditable="False" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Top" Text="Producer Notes" />
        <TextBox x:Name="ProducerNotesTextBox"
             Grid.Row="2"
             Grid.Column="1"
             Margin="0,0,0,12"
             MinHeight="64"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Save" Click="Save_OnClick" />
            <Button Width="100" Content="Cancel" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
