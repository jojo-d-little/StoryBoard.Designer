<UserControl x:Class="StoryboardDesigner.App.Features.SequenceDesigner.Views.SequenceDesignerWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,10" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton Content="Select" GroupName="SequenceTools" IsChecked="{Binding IsSequenceSelectToolActive, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0" ToolTip="Select a step and edit its properties" />
                    <RadioButton Content="Move" GroupName="SequenceTools" IsChecked="{Binding IsSequenceMoveToolActive, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0" ToolTip="Move a step in time without moving later steps" />
                    <RadioButton Content="Ripple" GroupName="SequenceTools" IsChecked="{Binding IsSequenceRippleToolActive, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0" ToolTip="Move a step and shift later steps by the same amount" />
                    <RadioButton Content="Relocate" GroupName="SequenceTools" IsChecked="{Binding IsSequenceRelocateToolActive, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0" ToolTip="Move a step to another time or branch; explicit outcome links stay attached" />
                    <Button Content="−" Click="ZoomOut_OnClick" Margin="4,0" Padding="10,5" ToolTip="Zoom out" />
                    <Button Content="+" Click="ZoomIn_OnClick" Margin="4,0" Padding="10,5" ToolTip="Zoom in" />
                    <Button Content="Fit sequence" Click="FitSequence_OnClick" Margin="4,0" Padding="10,5" />
                    <Button Content="Validate sequence" Command="{Binding ValidateSequenceCommand}" Margin="4,0" Padding="10,5" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Sequence Designer" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Editing scope: " Foreground="#6B7280" />
                        <TextBlock Text="{Binding SelectedSequenceScopeName}" Foreground="#6B7280" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Border Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    <RowDefinition Height="190" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="12,10" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Text="{Binding SelectedSequenceDefinition.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="190" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" />
                        <TextBlock Text="Lifetime" Foreground="#6B7280" VerticalAlignment="Center" Margin="14,0,5,0" />
                        <ComboBox Width="105" ItemsSource="{Binding SequenceLifetimeOwnerTypeOptions}"
                                  SelectedItem="{Binding SelectedSequenceDefinition.LifetimeOwnerType, Mode=TwoWay}" />
                        <TextBlock Text="Restart behavior" Foreground="#6B7280" VerticalAlignment="Center" Margin="14,0,5,0" />
                        <ComboBox Width="135" ItemsSource="{Binding SequenceStartConflictBehaviorOptions}"
                                  SelectedItem="{Binding SelectedSequenceDefinition.StartConflictBehavior, Mode=TwoWay}" />
                    </StackPanel>
                    <Border Grid.Row="1" Margin="10,0,10,10" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" ClipToBounds="True">
                        <ScrollViewer x:Name="SequenceCanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid x:Name="SequenceCanvasContent"
                                  Margin="18"
                                  SizeChanged="SequenceCanvasContent_OnSizeChanged"
                                  PreviewMouseMove="SequenceCanvasContent_OnPreviewMouseMove"
                                  PreviewDragOver="SequenceCanvasContent_OnPreviewDragOver"
                                  MouseLeave="SequenceCanvasContent_OnMouseLeave">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding SequenceZoom}" ScaleY="{Binding SequenceZoom}" />
                                </Grid.LayoutTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="SequenceTimelineRuler" Grid.Row="0">
                                <TextBlock Text="Timeline · positions snap to 50 ms" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                                <Canvas x:Name="SequenceTimelineRulerCanvas"
                                        Height="38"
                                        Background="#F8FAFC"
                                        Margin="0,0,0,5"
                                        AllowDrop="True"
                                        DragOver="TimelineTimeSlice_OnDragOver"
                                        Drop="SequenceTimelineRulerCanvas_OnDrop"
                                        ContextMenuOpening="SequenceTimelineRulerCanvas_OnContextMenuOpening" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                <ScrollViewer x:Name="SequenceBranchScrollViewer"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <Grid x:Name="SequenceBranchContent">
                                        <Canvas x:Name="SequenceFlowConnectionCanvas" IsHitTestVisible="False" Panel.ZIndex="2" />
                                        <Canvas x:Name="SequenceSoundEndMarkerCanvas" IsHitTestVisible="True" Panel.ZIndex="3" />
                                        <StackPanel Panel.ZIndex="1">
                                <ItemsControl ItemsSource="{Binding SequenceFlowTimeSlices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Padding="0" Margin="0,0,0,0" Tag="SequenceFlowCell"
                                                    AllowDrop="True" DragOver="TimelineTimeSlice_OnDragOver" Drop="TimelineTimeSlice_OnDrop"
                                                    ContextMenuOpening="TimelineTimeSlice_OnContextMenuOpening">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDisplayGap}" Value="True">
                                                                <Setter Property="BorderThickness" Value="0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <ItemsControl ItemsSource="{Binding Lanes}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Height="{Binding Height}" Tag="{Binding BranchId}" BorderThickness="0,0,0,1" Padding="4,3"
                                                                        Background="{Binding LaneBackground}" BorderBrush="{Binding LaneBorder}"
                                                                        AllowDrop="True" DragOver="TimelineTimeSlice_OnDragOver" Drop="TimelineTimeSlice_OnDrop"
                                                                        ContextMenuOpening="TimelineTimeSlice_OnContextMenuOpening">
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="2,0,0,3" />
                                                                        <ItemsControl ItemsSource="{Binding Columns}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                <ItemsControl ItemsSource="{Binding Cards}" Width="176" Margin="0,0,12,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Command="{Binding DataContext.SelectSequenceStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Step}" Padding="0" Margin="0,0,0,10"
                                                                                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                                                                    PreviewMouseLeftButtonDown="SequenceCard_OnPreviewMouseLeftButtonDown"
                                                                                    PreviewMouseMove="SequenceCard_OnPreviewMouseMove">
                                                                                <Border Padding="9" MinHeight="108" BorderThickness="1" CornerRadius="5">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background" Value="#FFFFFF" />
                                                                                            <Setter Property="BorderBrush" Value="#9CA3AF" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasValidationIssues}" Value="True">
                                                                                                    <Setter Property="Background" Value="#FEF2F2" />
                                                                                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding StepLabel}" Foreground="#6B7280" FontSize="10" />
                                                                                        <TextBlock Text="{Binding RoutingLabel}" Foreground="#64748B" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding ActionSourceLabel}" Foreground="#6B7280" FontSize="9" Margin="0,1,0,0">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsAction}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Foreground="#111827" />
                                                                                        <TextBlock Text="{Binding ActionDisplayName}" TextTrimming="CharacterEllipsis" Foreground="#374151" Margin="0,3,0,0">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsAction}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Text="{Binding SoundEffectLabel}" TextTrimming="CharacterEllipsis" Foreground="#374151" Margin="0,3,0,0">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsSound}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Text="{Binding SoundDurationLabel}" Foreground="#0F766E" FontSize="10" Margin="0,2,0,0">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsSound}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Text="{Binding SuccessTargetLabel}" TextTrimming="CharacterEllipsis" Foreground="#15803D" Margin="0,7,0,0">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding HasActionRouteTargets}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Text="{Binding FailureTargetLabel}" TextTrimming="CharacterEllipsis" Foreground="#B91C1C">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding HasActionRouteTargets}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Text="{Binding MergeTargetLabel}" TextTrimming="CharacterEllipsis" Foreground="#4B5563">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding HasSoundMergeTarget}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Text="{Binding ValidationMessage}" TextTrimming="CharacterEllipsis" Foreground="#B91C1C" FontSize="10" Margin="0,6,0,0">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding HasValidationIssues}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="+" FontSize="18" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasSteps}" Value="False" />
                                                                        <Condition Binding="{Binding IsDisplayGap}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="This sequence has no steps yet. Right-click a time slot to add an action or sound effect."
                                           Margin="0,20,0,0" Foreground="#6B7280" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedSequenceSteps}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </StackPanel>
                                        <Canvas x:Name="SequenceTimeMappingPreviewCanvas" IsHitTestVisible="False" Panel.ZIndex="4">
                                            <Line x:Name="SequenceTimeMappingPreviewLine"
                                                  Stroke="#2563EB"
                                                  StrokeThickness="2"
                                                  StrokeDashArray="3,2"
                                                  Visibility="Collapsed" />
                                        </Canvas>
                                    </Grid>
                                </ScrollViewer>
                                    <Border x:Name="SequenceTimeMappingPreviewReadout"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#1E40AF"
                                            CornerRadius="3"
                                            Padding="7,3"
                                            MaxWidth="420"
                                            IsHitTestVisible="False"
                                            Panel.ZIndex="5"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="SequenceTimeMappingPreviewLabel"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Row="2" Padding="12,8" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,5">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="Delete step" Command="{Binding DeleteSequenceStepCommand}" Padding="8,3" Margin="8,0,0,0" ToolTip="Delete this step and end any routes that target it" />
                                    <TextBlock Text="Selected step properties" FontWeight="SemiBold" Foreground="#374151" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SequenceValidationSummary}" Foreground="#B91C1C" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Grid Margin="0,2,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedSequenceActionStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Action" Foreground="#6B7280" VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSequenceActionDisplayName}" Foreground="#111827" FontWeight="SemiBold"
                                               TextWrapping="Wrap" VerticalAlignment="Top" ToolTip="{Binding SelectedSequenceActionDisplayName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedSequenceActionSourceDescription}" Foreground="#6B7280"
                                               VerticalAlignment="Top" Margin="12,2,0,0" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedSequenceActionStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <TextBlock Text="Action source" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="{Binding SequenceActionPickerButtonText}" Click="ChooseSequenceAction_OnClick"
                                                Padding="8,3" ToolTip="Choose from the current scope, its ancestors, or its children. Replacing an inline action discards its inline definition." />
                                        <Button Content="Edit inline action…" Command="{Binding EditSequenceActionCommand}"
                                                Margin="8,0,0,0" Padding="8,3">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelectedSequenceInlineAction}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedSequenceSoundStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sound effect" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SequenceSoundEffectChoices}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="SoundEffectId"
                                              SelectedValue="{Binding SelectedSequenceSoundEffectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="245" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Offset ms" Foreground="#6B7280" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Order" Foreground="#6B7280" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Step type" Foreground="#6B7280" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Branch" Foreground="#6B7280" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Continue mode" Foreground="#6B7280" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SelectedSequenceStep.OffsetMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,0" LostFocus="SequenceStepTiming_OnLostFocus" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSequenceStep.Order, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,0" LostFocus="SequenceStepTiming_OnLostFocus" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedSequenceStep.StepType}" IsReadOnly="True" Margin="0,2,6,0" />
                                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding SequenceBranchDefinitions}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="BranchId"
                                          SelectedValue="{Binding SelectedSequenceBranchId, Mode=TwoWay}" Margin="0,2,6,0"
                                          ToolTip="Branch steps continue in authored time and order." />
                                <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding SelectedSequenceContinuationModeChoices}" SelectedItem="{Binding SelectedSequenceContinuationMode, Mode=TwoWay}" Margin="0,2,6,0" />
                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedSequenceActionRouteMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="On success" Foreground="#15803D" />
                                        <ComboBox Tag="Success" ItemsSource="{Binding SequenceStepTargetChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSequenceSuccessTargetChoice, Mode=OneWay}" DropDownOpened="SequenceTargetComboBox_OnDropDownOpened" DropDownClosed="SequenceTargetComboBox_OnDropDownClosed" ToolTip="An unset outcome target ends the run." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="On failure" Foreground="#B91C1C" />
                                        <ComboBox Tag="Failure" ItemsSource="{Binding SequenceStepTargetChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSequenceFailureTargetChoice, Mode=OneWay}" DropDownOpened="SequenceTargetComboBox_OnDropDownOpened" DropDownClosed="SequenceTargetComboBox_OnDropDownClosed" ToolTip="An unset outcome target ends the run." />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="0,5,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedSequenceSoundMergeMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Merge target" Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="360" Tag="Merge" ItemsSource="{Binding SequenceMergeTargetChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSequenceMergeTargetChoice, Mode=OneWay}" DropDownOpened="SequenceTargetComboBox_OnDropDownOpened" DropDownClosed="SequenceTargetComboBox_OnDropDownClosed" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" Text="{Binding SelectedSequenceContinuationDescription}" Foreground="#64748B" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
