<Window x:Class="StoryboardDesigner.App.Features.SequenceDesigner.Views.PromoteSequenceActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Promote Inline Action"
        Height="190"
        Width="500"
        MinHeight="190"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#6B7280" Text="Reusable action name" />
        <TextBox x:Name="ActionNameTextBox" Grid.Row="1" Margin="0,4,0,0" />
        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#6B7280" Text="The action will be added to the sequence's scope. Other sequences in that scope can then reuse it." TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="84" Margin="0,0,8,0" Content="Promote" Click="Promote_OnClick" />
            <Button Width="84" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
