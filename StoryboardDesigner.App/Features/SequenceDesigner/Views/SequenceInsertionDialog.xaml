<Window x:Class="StoryboardDesigner.App.Features.SequenceDesigner.Views.SequenceInsertionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert into flow"
        SizeToContent="WidthAndHeight"
        MinWidth="560"
        MaxWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Choose where this step belongs in the flow." FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Text="Suggestions use the selected branch and timeline position. Existing connections are preserved around the new step." Margin="0,5,0,12" Foreground="#4B5563" TextWrapping="Wrap" />
        </StackPanel>
        <ComboBox x:Name="InsertionChoiceComboBox" Grid.Row="1" MinWidth="520" Padding="7,5"
                  DisplayMemberPath="DisplayName" SelectionChanged="InsertionChoiceComboBox_OnSelectionChanged" />
        <CheckBox x:Name="ShowAllConnectionsCheckBox" Grid.Row="2" Content="Show all connections" Margin="0,8,0,0"
                  Visibility="Collapsed" Checked="ShowAllConnectionsCheckBox_OnChanged" Unchecked="ShowAllConnectionsCheckBox_OnChanged" />
        <Border Grid.Row="3" Background="#F3F4F6" CornerRadius="4" Padding="10" Margin="0,12,0,16">
            <StackPanel>
                <TextBlock Text="Flow preview" FontSize="11" Foreground="#6B7280" />
                <TextBlock x:Name="FlowPreviewTextBlock" Margin="0,3,0,0" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" Padding="8,4" />
            <Button Content="Insert" IsDefault="True" MinWidth="84" Padding="8,4" Click="Insert_OnClick" />
        </StackPanel>
    </Grid>
</Window>
