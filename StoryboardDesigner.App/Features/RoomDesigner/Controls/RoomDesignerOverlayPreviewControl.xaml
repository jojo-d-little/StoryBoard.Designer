<UserControl x:Class="StoryboardDesigner.App.Views.Controls.RoomDesignerOverlayPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             d:DesignWidth="360">
    <Border Margin="4" Padding="8" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold" Text="Room Display Preview" />
            <ScrollViewer Grid.Row="1"
                          Margin="0,6,0,6"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          PanningMode="Both"
                          Background="Transparent">
                <Border Width="{Binding DesignerCanvasWidth}"
                        Height="{Binding DesignerCanvasHeight}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#F9FAFB">
                    <Grid x:Name="PreviewLayerGrid" ClipToBounds="True">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverlayMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Image Source="{Binding OverlayPreviewBaseImageSource}"
                               Stretch="None"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" />
                        <ItemsControl ItemsSource="{Binding OverlayPreviewSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="{Binding OverlayHorizontalAlignment}"
                                          VerticalAlignment="{Binding OverlayVerticalAlignment}">
                                        <Grid.RenderTransform>
                                            <TranslateTransform X="{Binding OverlayOffsetX}" Y="{Binding OverlayOffsetY}" />
                                        </Grid.RenderTransform>
                                        <Image Source="{Binding VariantThumbnailSource}"
                                               Stretch="None"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top">
                                            <Image.LayoutTransform>
                                                <RotateTransform Angle="{Binding OverlayRotationDegrees}" />
                                            </Image.LayoutTransform>
                                        </Image>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Image Source="{Binding IndependentPreviewImageSource}"
                           Stretch="None"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           RenderTransformOrigin="{Binding OverlayPreviewDirectionalRenderTransformOrigin}">
                        <Image.RenderTransform>
                            <RotateTransform Angle="{Binding OverlayPreviewDirectionalRotation}" />
                        </Image.RenderTransform>
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIndependentMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <Canvas x:Name="GridOverlayCanvas" IsHitTestVisible="False">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                    </Canvas>

                    <ItemsControl x:Name="RoomObjectPreviewItemsControl" ItemsSource="{Binding RenderableRoomChildObjects}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRenderableRoomChildObjects}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <!-- Object anchor in room space: this is the footprint origin. -->
                                <Setter Property="Canvas.Left" Value="{Binding PositionX}" />
                                <Setter Property="Canvas.Top" Value="{Binding PositionY}" />
                                <Setter Property="Panel.ZIndex" Value="{Binding DrawOrderZIndex}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas Width="{Binding FootprintWidthPixels}"
                                        Height="{Binding FootprintHeightPixels}"
                                        ClipToBounds="False">
                                    <!-- Visual footprint frame for selection/interaction bounds. -->
                                    <Button Padding="0"
                                            Background="Transparent"
                                            Width="{Binding FootprintWidthPixels}"
                                            Height="{Binding FootprintHeightPixels}"
                                            BorderThickness="1"
                                            BorderBrush="#2563EB"
                                            Canvas.Left="0"
                                            Canvas.Top="0"
                                            Panel.ZIndex="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            RenderTransformOrigin="0,0"
                                            PreviewMouseLeftButtonDown="RoomObjectThumb_OnPreviewMouseLeftButtonDown"
                                            PreviewMouseMove="RoomObjectThumb_OnPreviewMouseMove"
                                            PreviewMouseLeftButtonUp="RoomObjectThumb_OnPreviewMouseLeftButtonUp"
                                            Command="{Binding DataContext.SelectRoomChildObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                                                        <!-- Icon draw: local offset is computed in the VM, then image is rotated. -->
                                    <Image Source="{Binding ThumbnailSource}"
                                           Width="{Binding PreviewRenderedIconWidthPixels}"
                                           Height="{Binding PreviewRenderedIconHeightPixels}"
                                           Stretch="Uniform"
                                         Canvas.Left="{Binding ImageLocalAlignmentOffsetX}"
                                         Canvas.Top="{Binding ImageLocalAlignmentOffsetY}"
                                           Panel.ZIndex="1"
                                           IsHitTestVisible="False"
                                                                                     RenderTransformOrigin="0,0">
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="{Binding ImageRotationDegrees}" />
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No Preview Image" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowNoPreviewImagePlaceholder}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
