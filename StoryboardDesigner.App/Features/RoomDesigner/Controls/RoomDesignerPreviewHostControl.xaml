<UserControl x:Class="StoryboardDesigner.App.Views.Controls.RoomDesignerPreviewHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StoryboardDesigner.App.Views.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="360">
    <Grid>
        <controls:RoomDesignerOverlayPreviewControl>
            <controls:RoomDesignerOverlayPreviewControl.Style>
                <Style TargetType="controls:RoomDesignerOverlayPreviewControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverlayMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:RoomDesignerOverlayPreviewControl.Style>
        </controls:RoomDesignerOverlayPreviewControl>

        <controls:RoomDesignerIndependentPreviewControl>
            <controls:RoomDesignerIndependentPreviewControl.Style>
                <Style TargetType="controls:RoomDesignerIndependentPreviewControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIndependentMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:RoomDesignerIndependentPreviewControl.Style>
        </controls:RoomDesignerIndependentPreviewControl>
    </Grid>
</UserControl>
