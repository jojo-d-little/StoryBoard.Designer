<UserControl x:Class="StoryboardDesigner.App.Views.Controls.RoomDesignerWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StoryboardDesigner.App.Views.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="960"
             AutomationProperties.AutomationId="MainWindow.RoomDesigner.WorkspacePane">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <TabControl
                            AutomationProperties.AutomationId="MainWindow.RoomDesigner.OpenEditorsTabs"
                            ItemsSource="{Binding OpenRoomEditors}"
                            SelectedItem="{Binding SelectedRoomEditor, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Room.Name}" />
                                <Button Width="18"
                                        Height="18"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Content="X"
                                        FontWeight="SemiBold"
                                        ToolTip="Close room tab"
                                        Command="{Binding DataContext.CloseRoomEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Margin="0,0,0,10" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Background="#F9FAFB">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Mode" />
                                            <ComboBox Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding DisplayModeOptions}"
                                                      SelectedItem="{Binding RoomDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Text="Direction" />
                                            <ComboBox Grid.Column="4"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding DirectionSlots}"
                                                      SelectedItem="{Binding SelectedDirectionSlot, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DirectionShortLabel}" FontWeight="SemiBold" />
                                                            <TextBlock Text=" - " />
                                                            <TextBlock Text="{Binding DirectionStatusText}" Foreground="#6B7280" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="96" Height="54" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="#FFFFFF">
                                                    <Grid>
                                                        <Image Source="{Binding SelectedDirectionThumbnailSource}"
                                                               Stretch="Uniform">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowNoDirectionImagePlaceholder}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#x1F5BC;" FontSize="14" HorizontalAlignment="Center" />
                                                            <TextBlock Text="No image" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center" />
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowNoDirectionImagePlaceholder}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Button Margin="8,0,0,0"
                                                        Padding="12,4"
                                                        VerticalAlignment="Center"
                                                        Content="Edit"
                                                        Command="{Binding DataContext.EditRoomImageSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SelectedDirectionSlot}" />
                                            </StackPanel>

                                            <WrapPanel Grid.Column="7"
                                                       Orientation="Horizontal"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       ItemHeight="24">
                                                <CheckBox Content="Show Grid"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsGridVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Toggle the room grid overlay in the preview." />
                                                <CheckBox Content="Snap To Grid"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSnapToGridEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Snap drag and keyboard movement to project grid cell size." />
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="#4B5563"
                                                           FontSize="11"
                                                           Margin="0,0,10,0"
                                                           Text="{Binding RoomGridCellSize, StringFormat=Cell: {0}px}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="#4B5563"
                                                           FontSize="11"
                                                           Margin="0,0,10,0"
                                                           Text="{Binding EffectiveGridSummary}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="#92400E"
                                                           FontSize="11"
                                                           Text="{Binding SelectedDirectionHiddenIndicatorText}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="280" />
                                        </Grid.ColumnDefinitions>

                                        <controls:RoomDesignerOverlayPreviewControl Grid.Column="0" />

                                        <Border Grid.Column="2"
                                                BorderBrush="#D1D5DB"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Background="#F9FAFB"
                                                Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Room Objects" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                    <ComboBox Grid.Column="1"
                                                              Margin="8,0,0,0"
                                                              Height="24"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{Binding RoomChildObjectFilterOptions}"
                                                              SelectedItem="{Binding RoomChildObjectFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <Button Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            Height="24"
                                                            Padding="10,2"
                                                            VerticalAlignment="Center"
                                                            Content="Refresh"
                                                            ToolTip="Refresh room object list"
                                                            Command="{Binding DataContext.RefreshSelectedRoomEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </Grid>

                                                <ListBox Grid.Row="1"
                                                         Margin="0,8,0,0"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         ItemsSource="{Binding FilteredRoomChildObjects}"
                                                         SelectedItem="{Binding SelectedRoomChildObject, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0"
                                                                          VerticalAlignment="Center"
                                                                          IsChecked="{Binding IncludeInPreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                                <Border Grid.Column="1"
                                                                        Width="44"
                                                                        Height="28"
                                                                        Margin="8,0,8,0"
                                                                        BorderBrush="#CBD5E1"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3"
                                                                        Background="#FFFFFF">
                                                                    <Button Padding="0"
                                                                            BorderThickness="0"
                                                                            Background="Transparent"
                                                                            ToolTip="Click to choose image variant"
                                                                            Click="RoomObjectThumbnailButton_OnClick">
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu ItemsSource="{Binding AvailablePreviewVariantNames}">
                                                                                <ContextMenu.ItemContainerStyle>
                                                                                    <Style TargetType="MenuItem">
                                                                                        <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.SelectPreviewVariantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                                                                    </Style>
                                                                                </ContextMenu.ItemContainerStyle>
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                        <Image Source="{Binding ThumbnailSource}" Stretch="Uniform" />
                                                                    </Button>
                                                                </Border>

                                                                <TextBlock Grid.Column="2"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis" />

                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <Button Padding="6,2"
                                                                        Margin="0,0,4,0"
                                                                        Content="↑"
                                                                        ToolTip="Move up"
                                                                        Command="{Binding DataContext.MoveRoomChildObjectUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                    <Button Padding="6,2"
                                                                        Margin="0,0,4,0"
                                                                        Content="↓"
                                                                        ToolTip="Move down"
                                                                        Command="{Binding DataContext.MoveRoomChildObjectDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                    <Button Padding="8,2"
                                                                        Content="Edit"
                                                                        ToolTip="Edit image properties"
                                                                        Command="{Binding DataContext.EditRoomChildObjectImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <Border Grid.Row="2"
                                                        Margin="0,10,0,0"
                                                        Padding="8"
                                                        BorderBrush="#D1D5DB"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Background="#FFFFFF">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontWeight="SemiBold" Text="Selected Object Transform" />

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Position X" />
                                                        <TextBox Grid.Row="1"
                                                                 Grid.Column="1"
                                                                 Margin="0,8,0,0"
                                                                 Text="{Binding SelectedRoomChildObject.PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" />

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Position Y" />
                                                        <TextBox Grid.Row="2"
                                                                 Grid.Column="1"
                                                                 Margin="0,8,0,0"
                                                                 Text="{Binding SelectedRoomChildObject.PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" />

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Room Rotation" />
                                                        <ComboBox Grid.Row="3"
                                                                  Grid.Column="1"
                                                                  Margin="0,8,0,0"
                                                                  SelectedValuePath="Tag"
                                                                  SelectedValue="{Binding SelectedRoomChildObject.RoomRotationDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                            <ComboBoxItem Content="0" Tag="0" />
                                                            <ComboBoxItem Content="90" Tag="90" />
                                                            <ComboBoxItem Content="180" Tag="180" />
                                                            <ComboBoxItem Content="270" Tag="270" />
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>

                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
