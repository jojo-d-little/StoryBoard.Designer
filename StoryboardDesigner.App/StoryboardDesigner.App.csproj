<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\planet.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\planet.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="StarterProjects\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Storyboard.GameEngine" Version="1.0.11-local.20261001.t005148296" />
    <PackageReference Include="Storyboard.Contracts" Version="1.0.12-elevator.3" />
    <PackageReference Include="Storyboard.Foundation" Version="0.1.*-*" />
  </ItemGroup>

</Project>
